#!/usr/bin/env bash

#
# Interactive Git repository cleanup assistant.
#
# Features:
#   - Worktree cleanup with multi-select and fuzzy search
#   - Local branch cleanup with multi-select and fuzzy search
#   - GitHub PR merge detection
#   - Squash-merge aware branch cleanup
#   - Worktree dirty/locked protection
#   - Staleness information based on the latest commit
#   - Cached GitHub API data for large repositories
#   - Automatic dependency setup on macOS via Homebrew
#
# Safety principles:
#   - The primary worktree and its branch are never removed
#   - Dirty worktrees are never bulk deleted
#   - Checked-out branches are never deleted
#   - "gone" alone never causes forced branch deletion
#   - Forced branch deletion is automatically allowed only when GitHub
#     confirms that the corresponding pull request was merged
#

set -u

#
# Kept in step with the release tag by the "Verify the version constant" step in
# .github/workflows/bump-formula.yml, which fails the release when the two drift
# apart. An update check that reports a stale version is worse than none.
#
VERSION="0.1.1"

DEFAULT_STALE_DAYS=30
DEFAULT_HEIGHT=24
DEFAULT_BASE_REF="origin/main"

UPDATE_REPOSITORY="CodingSteve01/git-cleanup-assistant"
UPDATE_FORMULA="CodingSteve01/tap/git-cleanup-assistant"
UPDATE_CHECK_INTERVAL_SECONDS=86400
UPDATE_STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/git-cleanup-assistant/last-update-check"

# -----------------------------------------------------------------------------
# Temporary workspace
# -----------------------------------------------------------------------------

TMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/git-cleanup-assistant.XXXXXX")"

cleanup_tmp() {
    rm -rf "$TMP_ROOT"
}

trap cleanup_tmp EXIT INT TERM

WORKTREE_DATA="$TMP_ROOT/worktrees.tsv"
BRANCH_DATA="$TMP_ROOT/branches.tsv"
PR_CACHE="$TMP_ROOT/pr-cache.tsv"
PR_DEDUPE_AWK="$TMP_ROOT/pr-dedupe.awk"

#
# One branch head can carry several pull requests over its lifetime: a merged one
# and, later, a closed re-open or a revert experiment. Keeping the newest would
# report "closed" for a branch that is in fact merged, and the assistant would
# then refuse the very deletion the user asked for. A merged pull request wins.
#
cat > "$PR_DEDUPE_AWK" <<'AWK'
BEGIN { FS = "\t" }

{
    if (!($1 in best)) {
        order[++n] = $1
        best[$1] = $0
        merged[$1] = ($2 == "merged")
        next
    }

    if ($2 == "merged" && !merged[$1]) {
        best[$1] = $0
        merged[$1] = 1
    }
}

END {
    for (i = 1; i <= n; i++) {
        print best[order[i]]
    }
}
AWK

# -----------------------------------------------------------------------------
# Formatting
# -----------------------------------------------------------------------------

if [[ -t 1 ]]; then
    BOLD=$'\033[1m'
    GREEN=$'\033[32m'
    YELLOW=$'\033[33m'
    RED=$'\033[31m'
    CYAN=$'\033[36m'
    RESET=$'\033[0m'
else
    BOLD=""
    GREEN=""
    YELLOW=""
    RED=""
    CYAN=""
    RESET=""
fi

title() {
    echo
    echo "${BOLD}════════════════════════════════════════════════════════════${RESET}"
    echo "${BOLD}$1${RESET}"
    echo "${BOLD}════════════════════════════════════════════════════════════${RESET}"
}

success() {
    echo "${GREEN}✓ $*${RESET}"
}

warning() {
    echo "${YELLOW}⚠ $*${RESET}"
}

info() {
    echo "${CYAN}ℹ $*${RESET}"
}

error() {
    echo "${RED}✗ $*${RESET}"
}

die() {
    error "$*"
    exit 1
}

# -----------------------------------------------------------------------------
# Generic helpers
# -----------------------------------------------------------------------------

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

require_git_repository() {
    git rev-parse --git-dir >/dev/null 2>&1 ||
        die "This script must be run inside a Git repository."
}

confirm() {
    gum confirm "$1"
}

menu() {
    local header="$1"
    shift

    printf '%s\n' "$@" |
        gum choose \
            --height "$MENU_HEIGHT" \
            --header "$header"
}

input_value() {
    local placeholder="$1"
    local value="$2"

    gum input \
        --placeholder "$placeholder" \
        --value "$value"
}

plural_verb() {
    [[ "$1" -eq 1 ]] && echo "needs" || echo "need"
}

age_in_days() {
    local epoch="$1"
    local now

    now=$(date +%s)

    if [[ -z "$epoch" || "$epoch" == "0" ]]; then
        echo "?"
        return
    fi

    echo $(( (now - epoch) / 86400 ))
}

# -----------------------------------------------------------------------------
# Dependency bootstrap
# -----------------------------------------------------------------------------

ensure_homebrew() {
    if command -v brew >/dev/null 2>&1; then
        return
    fi

    echo "Homebrew is required to install dependencies."

    read -r -p "Install Homebrew now? [y/N] " answer

    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "Homebrew is required. Aborting."
        exit 1
    fi

    /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Apple Silicon Homebrew may not yet be in PATH in the current shell.
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi

    command_exists brew ||
        die "Homebrew was installed but is not available in PATH."
}

ensure_or_update_formula() {
    local command="$1"
    local formula="$2"
    local label="$3"

    if ! command -v "$command" >/dev/null 2>&1; then
        echo "$label is not installed."

        read -r -p "Install $label now? [Y/n] " answer
        answer="${answer:-y}"

        if [[ "$answer" =~ ^[Yy]$ ]]; then
            brew install "$formula"
        else
            echo "$label is required. Aborting."
            exit 1
        fi

        return
    fi

    # Check whether Homebrew manages this installation.
    if brew list --formula "$formula" >/dev/null 2>&1; then
        if brew outdated --formula "$formula" | grep -qx "$formula"; then
            echo "$label has an update available."

            read -r -p "Update $label now? [Y/n] " answer
            answer="${answer:-y}"

            if [[ "$answer" =~ ^[Yy]$ ]]; then
                brew upgrade "$formula"
            fi
        fi
    else
        echo "$label is installed, but not managed by Homebrew."
        echo "Leaving the existing installation untouched."
    fi
}

ensure_dependencies() {
    # Nothing to bootstrap when both dependencies are already on PATH.
    if command_exists gum && command_exists gh; then
        return
    fi

    if [[ "$(uname -s)" != "Darwin" ]]; then
        die "Please install 'gum' and 'gh' first; automatic setup supports macOS only."
    fi

    ensure_homebrew

    ensure_or_update_formula gum gum "Gum"
    ensure_or_update_formula gh gh "GitHub CLI"
}

ensure_github_auth() {
    if gh auth status >/dev/null 2>&1; then
        GH_AVAILABLE=true
        return
    fi

    GH_AVAILABLE=false

    title "GitHub Authentication"

    warning "GitHub CLI is installed but not authenticated."
    echo
    echo "GitHub authentication enables reliable detection of merged"
    echo "pull requests, including squash merges."
    echo

    if confirm "Run 'gh auth login' now?"; then
        gh auth login

        if gh auth status >/dev/null 2>&1; then
            GH_AVAILABLE=true
            success "GitHub authentication is available."
        else
            warning "GitHub authentication is still unavailable."
        fi
    else
        warning "Continuing without GitHub PR information."
    fi
}

# -----------------------------------------------------------------------------
# Update checking
# -----------------------------------------------------------------------------

#
# Compares two dotted versions and succeeds when the first one is strictly newer.
# The field sort keeps 0.10.0 above 0.2.0 without relying on GNU sort -V.
#
version_is_newer() {
    local candidate="$1"
    local current="$2"

    [[ "$candidate" == "$current" ]] && return 1

    local newest
    newest="$(
        printf '%s\n%s\n' "$candidate" "$current" |
            sort -t. -k1,1n -k2,2n -k3,3n |
            tail -1
    )"

    [[ "$newest" == "$candidate" ]]
}

update_check_is_due() {
    [[ -f "$UPDATE_STATE_FILE" ]] || return 0

    local last
    last="$(cat "$UPDATE_STATE_FILE" 2>/dev/null || echo 0)"

    [[ "$last" =~ ^[0-9]+$ ]] || return 0

    (( $(date +%s) - last >= UPDATE_CHECK_INTERVAL_SECONDS ))
}

record_update_check() {
    mkdir -p "$(dirname "$UPDATE_STATE_FILE")" 2>/dev/null || return 0
    date +%s > "$UPDATE_STATE_FILE" 2>/dev/null || true
}

installed_via_homebrew() {
    command_exists brew && brew list --formula git-cleanup-assistant >/dev/null 2>&1
}

#
# Runs at most once a day and never blocks the session: a missing release, a
# rate-limited API or no network all leave the assistant running as before.
# Set GIT_CLEANUP_ASSISTANT_NO_UPDATE_CHECK=1 to skip it entirely.
#
check_for_update() {
    [[ "${GIT_CLEANUP_ASSISTANT_NO_UPDATE_CHECK:-0}" == "1" ]] && return
    [[ "$GH_AVAILABLE" == true ]] || return
    update_check_is_due || return

    local latest
    latest="$(
        gh api "repos/$UPDATE_REPOSITORY/releases/latest" \
            --jq '.tag_name' \
            2>/dev/null |
            sed 's/^v//'
    )"

    record_update_check

    [[ -n "$latest" ]] || return
    version_is_newer "$latest" "$VERSION" || return

    title "Update Available"

    echo "Installed: $VERSION"
    echo "Latest:    $latest"
    echo
    echo "https://github.com/$UPDATE_REPOSITORY/releases/tag/v$latest"
    echo

    if ! installed_via_homebrew; then
        info "This copy is not managed by Homebrew; update it the way you installed it."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    if ! confirm "Update to $latest now?"; then
        return
    fi

    if ! brew upgrade "$UPDATE_FORMULA"; then
        warning "The update failed; continuing with $VERSION."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    #
    # Bash reads a script incrementally, so continuing inside a file that
    # Homebrew has just replaced is not safe. Hand over to the new copy instead.
    #
    local replacement
    replacement="$(command -v git-cleanup-assistant || true)"

    if [[ -n "$replacement" ]]; then
        success "Updated to $latest; restarting."
        exec "$replacement" "$@"
    fi

    success "Updated to $latest; start the assistant again to use it."
    exit 0
}

# -----------------------------------------------------------------------------
# Repository information
# -----------------------------------------------------------------------------

initialize_repository() {
    require_git_repository

    REPO_ROOT="$(git rev-parse --show-toplevel)"

    PRIMARY_WORKTREE="$(
        git worktree list --porcelain |
            awk '/^worktree / { print substr($0, 10); exit }'
    )"

    PRIMARY_BRANCH="$(
        git -C "$PRIMARY_WORKTREE" branch --show-current 2>/dev/null || true
    )"

    REPO_SLUG=""

    if [[ "$GH_AVAILABLE" == true ]]; then
        REPO_SLUG="$(
            gh repo view \
                --json nameWithOwner \
                --jq '.nameWithOwner' \
                2>/dev/null || true
        )"
    fi
}

# -----------------------------------------------------------------------------
# GitHub PR cache
# -----------------------------------------------------------------------------

refresh_pr_cache() {
    : > "$PR_CACHE"

    if [[ "$GH_AVAILABLE" != true || -z "$REPO_SLUG" ]]; then
        return
    fi

    #
    # Fetch all PRs once and cache the newest PR per head branch.
    #
    # This avoids one GitHub request per branch/worktree and therefore scales
    # much better for repositories with many local branches.
    #
    # GitHub returns 100 PRs per page. gh --paginate follows all pages.
    #

    gum spin \
        --spinner dot \
        --title "Loading GitHub pull request metadata..." \
        -- \
        bash -c "
            gh api --paginate \
                'repos/$REPO_SLUG/pulls?state=all&sort=created&direction=desc&per_page=100' \
                --jq '.[] |
                    [
                        .head.ref,
                        (if .merged_at != null then \"merged\" else .state end),
                        (.number | tostring),
                        .html_url
                    ] |
                    @tsv' \
            | awk -f '$PR_DEDUPE_AWK' \
            > '$PR_CACHE'
        "

    local count
    count=$(wc -l < "$PR_CACHE" | tr -d ' ')

    info "Cached GitHub metadata for $count branch heads."
}

pr_info_for_branch() {
    local branch="$1"

    if [[ ! -s "$PR_CACHE" ]]; then
        printf 'unknown\t\t'
        return
    fi

    awk -F '\t' -v branch="$branch" '
        $1 == branch {
            print $2 "\t" $3 "\t" $4
            found = 1
            exit
        }

        END {
            if (!found) {
                print "none\t\t"
            }
        }
    ' "$PR_CACHE"
}

# -----------------------------------------------------------------------------
# Worktree scanning
# -----------------------------------------------------------------------------

worktree_is_locked() {
    local target="$1"

    git worktree list --porcelain |
        awk -v target="$target" '
            /^worktree / {
                current = substr($0, 10)
            }

            current == target && /^locked/ {
                found = 1
            }

            END {
                exit !found
            }
        '
}

worktree_is_dirty() {
    local target="$1"

    [[ -n "$(
        git -C "$target" \
            status --porcelain --ignore-submodules=none \
            2>/dev/null
    )" ]]
}

branch_upstream_track() {
    local branch="$1"

    git for-each-ref \
        --format='%(upstream:track)' \
        "refs/heads/$branch"
}

scan_worktrees() {
    : > "$WORKTREE_DATA"

    local index=0

    git worktree list --porcelain |
        awk '/^worktree / { print substr($0, 10) }' |
        while IFS= read -r wt; do
            [[ "$wt" == "$PRIMARY_WORKTREE" ]] && continue
            [[ ! -d "$wt" ]] && continue

            index=$((index + 1))

            local branch
            local date
            local epoch
            local age
            local state
            local upstream
            local gone
            local locked
            local dirty
            local pr_state
            local pr_number
            local pr_url
            local pr_info

            branch="$(
                git -C "$wt" branch --show-current 2>/dev/null || true
            )"

            [[ -z "$branch" ]] && branch="(detached)"

            date="$(
                git -C "$wt" log -1 --format='%cs' 2>/dev/null ||
                    echo "unknown"
            )"

            epoch="$(
                git -C "$wt" log -1 --format='%ct' 2>/dev/null ||
                    echo "0"
            )"

            age="$(age_in_days "$epoch")"

            dirty=false
            locked=false
            gone=false

            if worktree_is_dirty "$wt"; then
                dirty=true
            fi

            if worktree_is_locked "$wt"; then
                locked=true
            fi

            upstream=""

            if [[ "$branch" != "(detached)" ]]; then
                upstream="$(branch_upstream_track "$branch")"

                if [[ "$upstream" == *"[gone]"* ]]; then
                    gone=true
                fi
            fi

            if [[ "$locked" == true ]]; then
                state="LOCKED"
            elif [[ "$dirty" == true ]]; then
                state="DIRTY"
            else
                state="CLEAN"
            fi

            pr_state="unknown"
            pr_number=""
            pr_url=""

            if [[ "$branch" != "(detached)" ]]; then
                pr_info="$(pr_info_for_branch "$branch")"

                IFS=$'\t' read -r pr_state pr_number pr_url <<EOF
$pr_info
EOF
            fi

            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "W$(printf '%05d' "$index")" \
                "$wt" \
                "$branch" \
                "$date" \
                "$age" \
                "$state" \
                "$gone" \
                "$pr_state" \
                "$pr_number" \
                "$pr_url" \
                "$epoch" \
                >> "$WORKTREE_DATA"
        done
}

# -----------------------------------------------------------------------------
# Branch scanning
# -----------------------------------------------------------------------------

branch_is_checked_out() {
    local branch="$1"

    [[ -n "$(branch_worktree_path "$branch")" ]]
}

#
# Git refuses to delete a branch that any worktree has checked out, and that is
# the one refusal the user cannot resolve by forcing. Report the path so the
# message names the worktree that has to go first.
#
branch_worktree_path() {
    local branch="$1"

    git worktree list --porcelain |
        awk -v ref="refs/heads/$branch" '
            /^worktree / {
                current = substr($0, 10)
            }

            $1 == "branch" && $2 == ref {
                print current
                exit
            }
        '
}

branch_field() {
    local id="$1"
    local column="$2"

    awk -F '\t' -v id="$id" -v column="$column" '
        $1 == id {
            print $column
            exit
        }
    ' "$BRANCH_DATA"
}

commits_not_on_base() {
    git rev-list --count "$BASE_REF..$1" 2>/dev/null || echo "?"
}

branch_is_merged_into_base() {
    git merge-base --is-ancestor "$1" "$BASE_REF" >/dev/null 2>&1
}

scan_branches() {
    : > "$BRANCH_DATA"

    local index=0

    git for-each-ref \
        --sort=committerdate \
        --format='%(refname:short)%09%(committerdate:short)%09%(committerdate:unix)%09%(upstream:short)%09%(upstream:track)' \
        refs/heads |
        while IFS=$'\t' read -r branch date epoch upstream track; do
            [[ "$branch" == "$PRIMARY_BRANCH" ]] && continue

            index=$((index + 1))

            local age
            local gone=false
            local checked_out=false
            local git_merged=false
            local pr_state
            local pr_number
            local pr_url
            local pr_info

            age="$(age_in_days "$epoch")"

            if [[ "$track" == *"[gone]"* ]]; then
                gone=true
            fi

            if branch_is_checked_out "$branch"; then
                checked_out=true
            fi

            if branch_is_merged_into_base "$branch"; then
                git_merged=true
            fi

            pr_info="$(pr_info_for_branch "$branch")"

            IFS=$'\t' read -r pr_state pr_number pr_url <<EOF
$pr_info
EOF

            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "B$(printf '%05d' "$index")" \
                "$branch" \
                "$date" \
                "$age" \
                "$upstream" \
                "$gone" \
                "$checked_out" \
                "$git_merged" \
                "$pr_state" \
                "$pr_number" \
                "$pr_url" \
                "$epoch" \
                >> "$BRANCH_DATA"
        done
}

refresh_repository_state() {
    gum spin \
        --spinner dot \
        --title "Scanning repository..." \
        -- \
        bash -c "
            exit 0
        "

    scan_worktrees
    scan_branches
}

# -----------------------------------------------------------------------------
# Counts / dashboard
# -----------------------------------------------------------------------------

count_rows() {
    local file="$1"

    if [[ ! -s "$file" ]]; then
        echo 0
    else
        wc -l < "$file" | tr -d ' '
    fi
}

count_worktree_state() {
    local state="$1"

    awk -F '\t' -v state="$state" '$6 == state { count++ } END { print count+0 }' \
        "$WORKTREE_DATA"
}

count_worktree_merged() {
    awk -F '\t' '$8 == "merged" { count++ } END { print count+0 }' \
        "$WORKTREE_DATA"
}

count_worktree_gone() {
    awk -F '\t' '$7 == "true" { count++ } END { print count+0 }' \
        "$WORKTREE_DATA"
}

count_branch_gone() {
    awk -F '\t' '$6 == "true" { count++ } END { print count+0 }' \
        "$BRANCH_DATA"
}

count_branch_merged_pr() {
    awk -F '\t' '$9 == "merged" { count++ } END { print count+0 }' \
        "$BRANCH_DATA"
}

count_branch_old() {
    awk -F '\t' -v days="$STALE_DAYS" '
        $4 != "?" && $4 >= days {
            count++
        }

        END {
            print count+0
        }
    ' "$BRANCH_DATA"
}

show_dashboard() {
    clear

    title "Git Cleanup Assistant"

    echo "Repository:      $REPO_ROOT"
    echo "Primary branch:  $PRIMARY_BRANCH"
    echo "Base ref:        $BASE_REF"
    echo "Stale threshold: ${STALE_DAYS} days"
    echo

    if [[ "$GH_AVAILABLE" == true ]]; then
        echo "GitHub:          ${GREEN}enabled${RESET}"
    else
        echo "GitHub:          ${YELLOW}unavailable${RESET}"
    fi

    echo
    echo "${BOLD}Worktrees${RESET}"
    printf "  %-18s %s\n" "Total:" "$(count_rows "$WORKTREE_DATA")"
    printf "  %-18s %s\n" "Clean:" "$(count_worktree_state CLEAN)"
    printf "  %-18s %s\n" "Dirty:" "$(count_worktree_state DIRTY)"
    printf "  %-18s %s\n" "Locked:" "$(count_worktree_state LOCKED)"
    printf "  %-18s %s\n" "Merged PR:" "$(count_worktree_merged)"
    printf "  %-18s %s\n" "Gone upstream:" "$(count_worktree_gone)"

    echo
    echo "${BOLD}Local branches${RESET}"
    printf "  %-18s %s\n" "Total:" "$(count_rows "$BRANCH_DATA")"
    printf "  %-18s %s\n" "Merged PR:" "$(count_branch_merged_pr)"
    printf "  %-18s %s\n" "Gone upstream:" "$(count_branch_gone)"
    printf "  %-18s %s\n" "Older than ${STALE_DAYS}d:" "$(count_branch_old)"

    echo
}

# -----------------------------------------------------------------------------
# Worktree display
# -----------------------------------------------------------------------------

worktree_display_rows() {
    local mode="$1"

    awk -F '\t' -v mode="$mode" -v stale="$STALE_DAYS" '
        function yn(v, yes, no) {
            return v == "true" ? yes : no
        }

        {
            id=$1
            path=$2
            branch=$3
            age=$5
            state=$6
            gone=$7
            pr=$8

            candidate = (pr == "merged" ||
                gone == "true" ||
                (age != "?" && age >= stale))

            safe = (state == "CLEAN")

            include = 0

            if (mode == "all") {
                include = 1
            }
            else if (mode == "candidates" && candidate) {
                include = 1
            }
            else if (mode == "safe" && candidate && safe) {
                include = 1
            }
            else if (mode == "dirty" && state != "CLEAN") {
                include = 1
            }

            if (!include) {
                next
            }

            printf "%s | %-6s | %-6s | %-4s | %4sd | %s | %s\n",
                id,
                state,
                (pr == "merged" ? "MERGED" : "-"),
                (gone == "true" ? "GONE" : "-"),
                age,
                branch,
                path
        }
    ' "$WORKTREE_DATA"
}

select_worktrees() {
    local mode="$1"
    local rows

    rows="$(worktree_display_rows "$mode")"

    if [[ -z "$rows" ]]; then
        warning "No matching worktrees."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return 1
    fi

    printf '%s\n' "$rows" |
        gum filter \
            --no-limit \
            --height "$LIST_HEIGHT" \
            --header "Tab / Ctrl+Space selects. Enter confirms. Type to filter." \
            --placeholder "Filter worktrees..."
}

selected_ids() {
    sed -E 's/^([^ ]+).*/\1/'
}

show_worktree_details() {
    local ids="$1"
    local detail_file="$TMP_ROOT/worktree-details.txt"

    : > "$detail_file"

    while IFS= read -r id; do
        [[ -z "$id" ]] && continue

        awk -F '\t' -v id="$id" '
            $1 == id {
                print "────────────────────────────────────────────────────────────"
                print $3
                print ""
                print "Path:        " $2
                print "Last commit: " $4 " (" $5 " days ago)"
                print "State:       " $6
                print "Gone:        " $7
                print "PR state:    " $8

                if ($9 != "") {
                    print "PR number:   #" $9
                }

                if ($10 != "") {
                    print "PR URL:      " $10
                }

                print ""
            }
        ' "$WORKTREE_DATA" >> "$detail_file"

        local path
        path="$(awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$WORKTREE_DATA")"

        if [[ -d "$path" ]]; then
            echo "Status:" >> "$detail_file"
            git -C "$path" status --short --ignore-submodules=none \
                >> "$detail_file" 2>&1 || true
            echo >> "$detail_file"

            echo "Recent commits:" >> "$detail_file"
            git -C "$path" log \
                -5 \
                --date=short \
                --format='%h %ad %s' \
                >> "$detail_file" 2>&1 || true

            echo >> "$detail_file"
        fi

    done <<< "$ids"

    gum pager < "$detail_file"
}

remove_selected_clean_worktrees() {
    local ids="$1"
    local count=0

    while IFS= read -r id; do
        [[ -z "$id" ]] && continue

        local path
        local branch
        local state

        path="$(
            awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$WORKTREE_DATA"
        )"

        branch="$(
            awk -F '\t' -v id="$id" '$1 == id { print $3 }' "$WORKTREE_DATA"
        )"

        state="$(
            awk -F '\t' -v id="$id" '$1 == id { print $6 }' "$WORKTREE_DATA"
        )"

        if [[ "$state" != "CLEAN" ]]; then
            warning "Skipping $branch: worktree is $state."
            continue
        fi

        if git worktree remove --force "$path"; then
            success "Removed worktree: $branch"
            count=$((count + 1))
        else
            warning "Could not remove: $branch"
        fi
    done <<< "$ids"

    git worktree prune

    info "Removed $count worktree(s)."
}

review_dirty_worktree() {
    local id="$1"

    local path
    local branch
    local state

    path="$(awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$WORKTREE_DATA")"
    branch="$(awk -F '\t' -v id="$id" '$1 == id { print $3 }' "$WORKTREE_DATA")"
    state="$(awk -F '\t' -v id="$id" '$1 == id { print $6 }' "$WORKTREE_DATA")"

    clear
    title "$branch"

    echo "Path:  $path"
    echo "State: $state"
    echo

    git -C "$path" status --short --ignore-submodules=none || true

    echo

    local action
    action="$(
        menu \
            "What should happen to this worktree?" \
            "Keep" \
            "Show recent commits" \
            "Remove and DISCARD local changes" \
            "Back"
    )"

    case "$action" in
        "Show recent commits")
            git -C "$path" log \
                -15 \
                --date=short \
                --format='%h %ad %s' |
                gum pager
            ;;

        "Remove and DISCARD local changes")
            warning "This will permanently discard local changes."

            if confirm "Really delete worktree '$branch'?"; then
                local typed

                typed="$(
                    gum input \
                        --placeholder "Type DELETE to confirm"
                )"

                if [[ "$typed" == "DELETE" ]]; then
                    if [[ "$state" == "LOCKED" ]]; then
                        git worktree unlock "$path" || true
                    fi

                    git worktree remove --force "$path"
                    git worktree prune
                else
                    info "Confirmation did not match."
                fi
            fi
            ;;
    esac
}

worktree_menu() {
    while true; do
        refresh_repository_state

        clear
        title "Worktree Cleanup"

        local action
        action="$(
            menu \
                "Choose a worktree cleanup mode" \
                "Safe cleanup candidates" \
                "All cleanup candidates" \
                "Dirty / locked worktrees" \
                "Browse all worktrees" \
                "Back"
        )"

        case "$action" in
            "Safe cleanup candidates")
                local selected
                local ids

                selected="$(select_worktrees safe)" || continue
                [[ -z "$selected" ]] && continue

                ids="$(printf '%s\n' "$selected" | selected_ids)"

                local next
                next="$(
                    menu \
                        "Selected worktrees" \
                        "Remove selected CLEAN worktrees" \
                        "Inspect selection" \
                        "Cancel"
                )"

                case "$next" in
                    "Remove selected CLEAN worktrees")
                        show_worktree_details "$ids"

                        if confirm "Remove the selected clean worktrees?"; then
                            remove_selected_clean_worktrees "$ids"
                        fi
                        ;;

                    "Inspect selection")
                        show_worktree_details "$ids"
                        ;;
                esac
                ;;

            "All cleanup candidates")
                local selected
                local ids

                selected="$(select_worktrees candidates)" || continue
                [[ -z "$selected" ]] && continue

                ids="$(printf '%s\n' "$selected" | selected_ids)"

                show_worktree_details "$ids"

                local next
                next="$(
                    menu \
                        "What should happen?" \
                        "Remove CLEAN worktrees from selection" \
                        "Review dirty / locked items individually" \
                        "Cancel"
                )"

                case "$next" in
                    "Remove CLEAN worktrees from selection")
                        if confirm "Remove all CLEAN worktrees in this selection?"; then
                            remove_selected_clean_worktrees "$ids"
                        fi
                        ;;

                    "Review dirty / locked items individually")
                        while IFS= read -r id; do
                            [[ -z "$id" ]] && continue

                            local state
                            state="$(
                                awk -F '\t' -v id="$id" \
                                    '$1 == id { print $6 }' \
                                    "$WORKTREE_DATA"
                            )"

                            if [[ "$state" != "CLEAN" ]]; then
                                review_dirty_worktree "$id"
                            fi
                        done <<< "$ids"
                        ;;
                esac
                ;;

            "Dirty / locked worktrees")
                local selected
                local ids

                selected="$(select_worktrees dirty)" || continue
                [[ -z "$selected" ]] && continue

                ids="$(printf '%s\n' "$selected" | selected_ids)"

                while IFS= read -r id; do
                    [[ -z "$id" ]] && continue
                    review_dirty_worktree "$id"
                done <<< "$ids"
                ;;

            "Browse all worktrees")
                local selected
                local ids

                selected="$(select_worktrees all)" || continue
                [[ -z "$selected" ]] && continue

                ids="$(printf '%s\n' "$selected" | selected_ids)"
                show_worktree_details "$ids"
                ;;

            *)
                return
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Branch display
# -----------------------------------------------------------------------------

branch_display_rows() {
    local mode="$1"

    awk -F '\t' -v mode="$mode" '
        {
            id=$1
            branch=$2
            age=$4
            gone=$6
            checked=$7
            gitmerged=$8
            pr=$9

            #
            # A branch a worktree has checked out is a candidate like any other
            # now that deleting it clears the worktree first.
            #
            if (mode != "all" && !(mode == "merged" && pr == "merged")) {
                next
            }

            printf "%s | %-6s | %-4s | %-6s | %-7s | %4sd | %s\n",
                id,
                (pr == "merged" ? "MERGED" : "-"),
                (gone == "true" ? "GONE" : "-"),
                (gitmerged == "true" ? "GIT" : "-"),
                (checked == "true" ? "IN-WT" : "-"),
                age,
                branch
        }
    ' "$BRANCH_DATA"
}

select_branches() {
    local mode="$1"
    local rows

    rows="$(branch_display_rows "$mode")"

    if [[ -z "$rows" ]]; then
        warning "No matching branches."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return 1
    fi

    printf '%s\n' "$rows" |
        gum filter \
            --no-limit \
            --height "$LIST_HEIGHT" \
            --header "Type MERGED, GONE, GIT or IN-WT to narrow. Tab selects, Enter confirms." \
            --placeholder "Filter branches..."
}

show_branch_details() {
    local ids="$1"
    local detail_file="$TMP_ROOT/branch-details.txt"

    : > "$detail_file"

    while IFS= read -r id; do
        [[ -z "$id" ]] && continue

        local branch

        branch="$(
            awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$BRANCH_DATA"
        )"

        awk -F '\t' -v id="$id" '
            $1 == id {
                print "────────────────────────────────────────────────────────────"
                print $2
                print ""
                print "Last commit:   " $3 " (" $4 " days ago)"
                print "Upstream:      " ($5 == "" ? "(none)" : $5)
                print "Gone:          " $6
                print "In worktree:   " $7
                print "Git merged:    " $8
                print "PR state:      " $9

                if ($10 != "") {
                    print "PR number:     #" $10
                }

                if ($11 != "") {
                    print "PR URL:        " $11
                }

                print ""
            }
        ' "$BRANCH_DATA" >> "$detail_file"

        echo "Recent commits:" >> "$detail_file"

        git log \
            "$branch" \
            -5 \
            --date=short \
            --format='%h %ad %s' \
            >> "$detail_file" 2>&1 || true

        echo >> "$detail_file"

    done <<< "$ids"

    gum pager < "$detail_file"
}

#
# Prints Git's own refusal instead of swallowing it. A bare "Git refused" leaves
# the user without the one piece of information that decides what to do next:
# an unmerged branch needs a forced deletion, a checked-out branch needs its
# worktree removed first, and those two look identical from the outside.
#
report_git_refusal() {
    local branch="$1"
    local output="$2"

    warning "Git refused to delete '$branch':"
    printf '%s\n' "$output" | sed 's/^/    /'
}

worktree_state() {
    local path="$1"

    if worktree_is_locked "$path"; then
        echo "LOCKED"
    elif worktree_is_dirty "$path"; then
        echo "DIRTY"
    else
        echo "CLEAN"
    fi
}

#
# A branch that a worktree has checked out cannot be deleted at all, and no
# amount of forcing changes that. Clearing the worktree is therefore part of
# deleting the branch, not a separate errand in another menu.
#
# The state is read here rather than taken from the scan, because a worktree can
# turn dirty between the scan and this prompt.
#
remove_blocking_worktree() {
    local branch="$1"
    local path
    local state
    local output

    path="$(branch_worktree_path "$branch")"

    [[ -z "$path" ]] && return 0

    if [[ "$path" == "$PRIMARY_WORKTREE" ]]; then
        warning "'$branch' is checked out in the primary worktree, which always stays."
        return 1
    fi

    state="$(worktree_state "$path")"

    echo
    echo "${BOLD}$branch${RESET}"
    echo "  Worktree: $path"
    echo "  State:    $state"
    echo

    if [[ "$state" == "DIRTY" ]]; then
        git -C "$path" status --short --ignore-submodules=none || true
        echo
        warning "Removing this worktree permanently discards those changes."
    fi

    if ! confirm "Remove the worktree and free '$branch'?"; then
        info "Keeping '$branch'."
        return 1
    fi

    if [[ "$state" == "DIRTY" ]]; then
        local typed
        typed="$(gum input --placeholder "Type DELETE to discard the changes")"

        if [[ "$typed" != "DELETE" ]]; then
            info "Confirmation did not match; keeping '$branch'."
            return 1
        fi
    fi

    if [[ "$state" == "LOCKED" ]]; then
        git worktree unlock "$path" >/dev/null 2>&1 || true
    fi

    if ! output="$(git worktree remove --force "$path" 2>&1)"; then
        warning "Could not remove the worktree at $path:"
        printf '%s\n' "$output" | sed 's/^/    /'
        return 1
    fi

    git worktree prune
    success "Removed worktree: $path"
}

#
# Answers what 'git branch -d' would answer, without running it: Git accepts a
# branch that is reachable from HEAD or from its own upstream. Asking first is
# what keeps the assistant from tearing down a worktree for a deletion that then
# fails anyway.
#
branch_is_safely_deletable() {
    local branch="$1"
    local upstream

    git merge-base --is-ancestor "$branch" HEAD 2>/dev/null && return 0

    upstream="$(
        git for-each-ref --format='%(upstream:short)' "refs/heads/$branch"
    )"

    [[ -n "$upstream" ]] || return 1

    git merge-base --is-ancestor "$branch" "$upstream" 2>/dev/null
}

#
# The deletion rule both passes share. Ancestry against BASE_REF licenses a
# forced deletion; everything else has to survive Git's own check.
#
# Exit codes: 0 deleted, 2 refused as unmerged, 1 refused for any other reason.
#
delete_branch_under_policy() {
    local id="$1"

    local branch
    local git_merged
    local output

    branch="$(branch_field "$id" 2)"
    git_merged="$(branch_field "$id" 8)"

    if [[ "$git_merged" == "true" ]]; then
        if output="$(git branch -D "$branch" 2>&1)"; then
            success "Deleted (merged into $BASE_REF): $branch"
            return 0
        fi

        report_git_refusal "$branch" "$output"
        return 1
    fi

    if output="$(git branch -d "$branch" 2>&1)"; then
        success "Deleted: $branch"
        return 0
    fi

    report_git_refusal "$branch" "$output"

    [[ "$output" == *"not fully merged"* ]] && return 2

    return 1
}

#
# Second pass for the branches a worktree pinned during the bulk run. Keeping it
# out of the main loop means a large selection still runs unattended and only
# stops for the few that need a decision.
#
#
# Forced deletion drops the branch label, never the commits, so the hash is
# printed with the command that brings the branch back.
#
force_delete_branch() {
    local branch="$1"
    local hash
    local output

    hash="$(git rev-parse --short "$branch" 2>/dev/null || echo "?")"

    if output="$(git branch -D "$branch" 2>&1)"; then
        success "Deleted: $branch (restore with 'git branch $branch $hash')"
        return 0
    fi

    report_git_refusal "$branch" "$output"
    return 1
}

#
# What the assistant knows about a branch, in the terms the user cares about.
#
#   PRIMARY  the primary worktree has it checked out; it always stays
#   PROVEN   ancestry against BASE_REF or a merged pull request settles it
#   SAFE     Git itself would accept the deletion
#   FORCE    nothing proves it is merged; only a forced deletion removes it
#
# The suffix ":WT" means a worktree still has the branch checked out, so the
# worktree has to go first whatever the class says.
#
classify_branch() {
    local id="$1"

    local branch
    local git_merged
    local pr
    local path
    local class

    branch="$(branch_field "$id" 2)"
    git_merged="$(branch_field "$id" 8)"
    pr="$(branch_field "$id" 9)"
    path="$(branch_worktree_path "$branch")"

    if [[ -n "$path" && "$path" == "$PRIMARY_WORKTREE" ]]; then
        echo "PRIMARY"
        return
    fi

    if [[ "$git_merged" == "true" || "$pr" == "merged" ]]; then
        class="PROVEN"
    elif branch_is_safely_deletable "$branch"; then
        class="SAFE"
    else
        class="FORCE"
    fi

    [[ -n "$path" ]] && class="$class:WT"

    echo "$class"
}

write_evidence_table() {
    local ids="$1"
    local report="$2"

    {
        printf '%-8s  %-4s  %-6s  %8s  %s\n' \
            "PR" "GONE" "IN-WT" "UNMERGED" "BRANCH"
        printf '%-8s  %-4s  %-6s  %8s  %s\n' \
            "--------" "----" "------" "--------" "------"
    } > "$report"

    while IFS= read -r id; do
        [[ -z "$id" ]] && continue

        local branch
        local gone
        local pr

        branch="$(branch_field "$id" 2)"
        gone="$(branch_field "$id" 6)"
        pr="$(branch_field "$id" 9)"

        printf '%-8s  %-4s  %-6s  %8s  %s\n' \
            "${pr:-unknown}" \
            "$([[ "$gone" == "true" ]] && echo yes || echo no)" \
            "$([[ -n "$(branch_worktree_path "$branch")" ]] && echo yes || echo no)" \
            "$(commits_not_on_base "$branch")" \
            "$branch" \
            >> "$report"
    done <<< "$ids"
}

#
# One action for the whole selection.
#
# Asking the user to pick a deletion strategy up front was the reason a run could
# end with nothing deleted: a mixed selection has no single right strategy, and
# whichever one was chosen silently dropped the branches it did not cover. The
# assistant already knows per branch what applies, so it decides, shows the plan,
# and asks only where the answer costs something.
#
delete_selected_branches() {
    local ids="$1"

    local proven="$TMP_ROOT/plan-proven.txt"
    local forced="$TMP_ROOT/plan-forced.txt"
    local kept="$TMP_ROOT/plan-kept.txt"
    local report="$TMP_ROOT/plan-evidence.txt"

    : > "$proven"
    : > "$forced"
    : > "$kept"

    local blocked_proven=0
    local blocked_forced=0

    while IFS= read -r id; do
        [[ -z "$id" ]] && continue

        case "$(classify_branch "$id")" in
            PRIMARY)
                echo "$id" >> "$kept"
                ;;
            PROVEN|SAFE)
                echo "$id" >> "$proven"
                ;;
            PROVEN:WT|SAFE:WT)
                echo "$id" >> "$proven"
                blocked_proven=$((blocked_proven + 1))
                ;;
            FORCE)
                echo "$id" >> "$forced"
                ;;
            FORCE:WT)
                echo "$id" >> "$forced"
                blocked_forced=$((blocked_forced + 1))
                ;;
        esac
    done <<< "$ids"

    local proven_count
    local forced_count
    local kept_count

    proven_count=$(wc -l < "$proven" | tr -d ' ')
    forced_count=$(wc -l < "$forced" | tr -d ' ')
    kept_count=$(wc -l < "$kept" | tr -d ' ')

    clear
    title "Deletion Plan"

    if [[ "$proven_count" -gt 0 ]]; then
        echo "  ${GREEN}$proven_count${RESET} delete"
        echo "      merged into $BASE_REF, confirmed by a merged pull request,"
        echo "      or accepted by Git itself"

        if [[ "$blocked_proven" -gt 0 ]]; then
            echo "      $blocked_proven of them $(plural_verb "$blocked_proven") a worktree removed first"
        fi

        echo
    fi

    if [[ "$forced_count" -gt 0 ]]; then
        echo "  ${YELLOW}$forced_count${RESET} force delete"
        echo "      nothing proves these are merged; confirmed separately"

        if [[ "$blocked_forced" -gt 0 ]]; then
            echo "      $blocked_forced of them $(plural_verb "$blocked_forced") a worktree removed first"
        fi

        echo
    fi

    if [[ "$kept_count" -gt 0 ]]; then
        echo "  ${CYAN}$kept_count${RESET} keep"
        echo "      checked out in the primary worktree, which always stays"
        echo
    fi

    if [[ "$proven_count" -eq 0 && "$forced_count" -eq 0 ]]; then
        warning "Nothing in this selection can be deleted."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    if ! confirm "Run this plan?"; then
        return
    fi

    echo

    if [[ "$proven_count" -gt 0 ]]; then
        run_proven_deletions "$proven"
    fi

    if [[ "$forced_count" -gt 0 ]]; then
        run_forced_deletions "$forced" "$report"
    fi

    echo
    gum input --placeholder "Press Enter to continue" >/dev/null
}

run_proven_deletions() {
    local list="$1"

    while IFS= read -r id; do
        [[ -z "$id" ]] && continue

        local branch
        branch="$(branch_field "$id" 2)"

        remove_blocking_worktree "$branch" || continue
        delete_branch_under_policy "$id"
    done < "$list"
}

#
# The evidence table and the typed confirmation cover the whole forced group at
# once. A squash merge leaves every branch looking unmerged, so this is the
# normal path in a squash-merge repository, not an exception.
#
run_forced_deletions() {
    local list="$1"
    local report="$2"

    local count
    count=$(wc -l < "$list" | tr -d ' ')

    write_evidence_table "$(cat "$list")" "$report"

    echo
    gum pager < "$report"

    warning "Force deleting $count branch(es) skips every merge check."
    echo
    echo "UNMERGED counts commits that are not on $BASE_REF. A squash merge"
    echo "rewrites the commits, so a squash-merged branch shows a count here"
    echo "too; a non-zero number is not by itself proof of lost work."
    echo
    echo "The commit hash of every deleted branch is printed, and it stays in"
    echo "the reflog, so a branch can be restored with 'git branch <name> <hash>'."
    echo

    if ! confirm "Force delete these $count branches?"; then
        info "Kept all $count."
        return
    fi

    local typed
    typed="$(gum input --placeholder "Type DELETE to confirm")"

    if [[ "$typed" != "DELETE" ]]; then
        warning "Confirmation did not match; kept all $count."
        return
    fi

    while IFS= read -r id; do
        [[ -z "$id" ]] && continue

        local branch
        branch="$(branch_field "$id" 2)"

        remove_blocking_worktree "$branch" || continue
        force_delete_branch "$branch"
    done < "$list"
}

review_branch_individually() {
    local id="$1"

    local branch
    local worktree
    local pr
    local gone

    branch="$(branch_field "$id" 2)"
    pr="$(branch_field "$id" 9)"
    gone="$(branch_field "$id" 6)"
    worktree="$(branch_worktree_path "$branch")"

    clear
    title "$branch"

    git log \
        "$branch" \
        -15 \
        --date=short \
        --format='%h %ad %s' |
        gum pager

    if [[ -n "$worktree" ]]; then
        warning "This branch is checked out in $worktree."
        echo

        if ! remove_blocking_worktree "$branch"; then
            gum input --placeholder "Press Enter to continue" >/dev/null
            return
        fi
    fi

    local action
    action="$(
        menu \
            "What should happen?" \
            "Try safe delete" \
            "Force delete local branch" \
            "Keep" \
            "Back"
    )"

    case "$action" in
        "Try safe delete")
            local output

            if output="$(git branch -d "$branch" 2>&1)"; then
                success "Deleted branch."
            else
                report_git_refusal "$branch" "$output"
                gum input --placeholder "Press Enter to continue" >/dev/null
            fi
            ;;

        "Force delete local branch")
            warning "This may delete the only remaining copy of unmerged work."

            if [[ "$pr" == "merged" ]]; then
                info "GitHub reports that this branch's PR was merged."
            elif [[ "$gone" == "true" ]]; then
                warning "The remote branch is gone, but that does NOT prove it was merged."
            fi

            if confirm "Force delete '$branch'?"; then
                local typed

                typed="$(
                    gum input \
                        --placeholder "Type DELETE to confirm"
                )"

                if [[ "$typed" == "DELETE" ]]; then
                    force_delete_branch "$branch"
                fi
            fi
            ;;
    esac
}

#
# One list, one action.
#
# The old flow asked for a cleanup mode before showing anything, then asked which
# deletion strategy to use. Both questions came too early: the buckets overlap, so
# there is no right mode to pick, and a mixed selection has no single right
# strategy. The list already carries the flags, gum filters on them as you type,
# and the plan decides the strategy per branch.
#
branch_menu() {
    while true; do
        refresh_repository_state

        clear
        title "Local Branch Cleanup"

        local selected
        local ids

        selected="$(select_branches all)" || return
        [[ -z "$selected" ]] && return

        ids="$(printf '%s\n' "$selected" | selected_ids)"

        local next
        next="$(
            menu \
                "$(wc -l <<< "$ids" | tr -d ' ') branch(es) selected" \
                "Delete selected" \
                "Inspect selection" \
                "Review selected individually" \
                "Back to the list"
        )"

        case "$next" in
            "Delete selected")
                delete_selected_branches "$ids"
                ;;

            "Inspect selection")
                show_branch_details "$ids"
                ;;

            "Review selected individually")
                while IFS= read -r id; do
                    [[ -z "$id" ]] && continue
                    review_branch_individually "$id"
                done <<< "$ids"
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Guided cleanup
# -----------------------------------------------------------------------------

guided_cleanup() {
    while true; do
        refresh_repository_state

        local clean_candidates
        local merged_branches

        clean_candidates="$(
            awk -F '\t' -v stale="$STALE_DAYS" '
                $6 == "CLEAN" &&
                ($8 == "merged" ||
                    $7 == "true" ||
                    ($5 != "?" && $5 >= stale)) {
                    count++
                }

                END {
                    print count+0
                }
            ' "$WORKTREE_DATA"
        )"

        merged_branches="$(
            awk -F '\t' '
                $9 == "merged" {
                    count++
                }

                END {
                    print count+0
                }
            ' "$BRANCH_DATA"
        )"

        clear
        title "Guided Cleanup"

        echo "Recommended cleanup candidates:"
        echo
        echo "  Clean worktrees:           $clean_candidates"
        echo "  Merged-PR local branches:  $merged_branches"
        echo

        if [[ "$clean_candidates" -eq 0 && "$merged_branches" -eq 0 ]]; then
            success "No strong cleanup candidates remain."
            echo
            gum input --placeholder "Press Enter to return" >/dev/null
            return
        fi

        local action
        action="$(
            menu \
                "What should we clean next?" \
                "Clean worktree candidates" \
                "Merged-PR local branches" \
                "Review everything manually" \
                "Stop guided cleanup"
        )"

        case "$action" in
            "Clean worktree candidates")
                local selected
                local ids

                selected="$(select_worktrees safe)" || continue
                [[ -z "$selected" ]] && continue

                ids="$(printf '%s\n' "$selected" | selected_ids)"

                show_worktree_details "$ids"

                if confirm "Remove the selected clean worktrees?"; then
                    remove_selected_clean_worktrees "$ids"
                fi
                ;;

            "Merged-PR local branches")
                local selected
                local ids

                selected="$(select_branches merged)" || continue
                [[ -z "$selected" ]] && continue

                ids="$(printf '%s\n' "$selected" | selected_ids)"

                delete_selected_branches "$ids"
                ;;

            "Review everything manually")
                return
                ;;

            *)
                return
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Final report
# -----------------------------------------------------------------------------

show_final_report() {
    refresh_repository_state

    clear
    title "Cleanup Summary"

    echo "${BOLD}Remaining worktrees${RESET}"
    echo
    git worktree list

    echo
    echo "${BOLD}Remaining local branches with gone upstream${RESET}"
    echo

    local remaining

    remaining="$(
        git for-each-ref \
            --sort=committerdate \
            --format='%(committerdate:short)  %(refname:short)  %(upstream:track)' \
            refs/heads |
            grep '\[gone\]' || true
    )"

    if [[ -n "$remaining" ]]; then
        echo "$remaining"
    else
        success "None."
    fi

    echo
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

ensure_dependencies
ensure_github_auth

require_git_repository
check_for_update "$@"

initialize_repository

MENU_HEIGHT="$DEFAULT_HEIGHT"
LIST_HEIGHT="$DEFAULT_HEIGHT"

clear
title "Git Cleanup Assistant"

echo "Repository:     $REPO_ROOT"
echo "Primary tree:   $PRIMARY_WORKTREE"
echo "Primary branch: $PRIMARY_BRANCH"
echo

if confirm "Fetch remote references and prune deleted tracking branches?"; then
    git fetch --prune
fi

STALE_DAYS="$(
    input_value \
        "Number of days after which inactivity is considered stale" \
        "$DEFAULT_STALE_DAYS"
)"

if ! [[ "$STALE_DAYS" =~ ^[0-9]+$ ]]; then
    warning "Invalid stale threshold; using $DEFAULT_STALE_DAYS days."
    STALE_DAYS="$DEFAULT_STALE_DAYS"
fi

BASE_REF="$(
    input_value \
        "Base ref used for Git merge checks" \
        "$DEFAULT_BASE_REF"
)"

if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
    warning "'$BASE_REF' does not exist; using $DEFAULT_BASE_REF."
    BASE_REF="$DEFAULT_BASE_REF"
fi

if [[ "$GH_AVAILABLE" == true ]]; then
    refresh_pr_cache
fi

refresh_repository_state

while true; do
    show_dashboard

    action="$(
        menu \
            "What would you like to do?" \
            "Guided cleanup" \
            "Worktrees" \
            "Local branches" \
            "Refresh Git / GitHub data" \
            "Show remaining summary" \
            "Finish"
    )"

    case "$action" in
        "Guided cleanup")
            guided_cleanup
            ;;

        "Worktrees")
            worktree_menu
            ;;

        "Local branches")
            branch_menu
            ;;

        "Refresh Git / GitHub data")
            if confirm "Fetch and prune remotes?"; then
                git fetch --prune
            fi

            if [[ "$GH_AVAILABLE" == true ]]; then
                refresh_pr_cache
            fi

            refresh_repository_state
            ;;

        "Show remaining summary")
            show_final_report
            gum input --placeholder "Press Enter to continue" >/dev/null
            ;;

        "Finish"|*)
            break
            ;;
    esac
done

show_final_report

success "Cleanup assistant finished."