#!/usr/bin/env bash

#
# Interactive Git repository cleanup assistant.
#
# Features:
#   - Worktree cleanup with multi-select and fuzzy search
#   - Local branch cleanup with multi-select and fuzzy search
#   - GitHub PR merge detection
#   - Squash-merge aware branch cleanup
#   - Worktree dirty/locked protection
#   - Staleness information based on the latest commit
#   - Cached GitHub API data for large repositories
#   - Automatic dependency setup on macOS via Homebrew
#
# Safety principles:
#   - The primary worktree and its branch are never removed
#   - Dirty worktrees are never bulk deleted
#   - Checked-out branches are never deleted
#   - "gone" alone never causes forced branch deletion
#   - Forced branch deletion is automatically allowed only when GitHub
#     confirms that the corresponding pull request was merged
#

set -u

#
# Written by release-please, which derives the next version from the Conventional
# Commit subjects since the last tag. The trailing annotation is what tells it to
# rewrite this line, so do not edit either by hand.
#
VERSION="0.3.0" # x-release-please-version

#
# Branches that outlive the work merged out of them.
#
# A release branch is merged into main and then carries on, so every rung of the
# ladder reports it as finished and it is exactly the kind of branch a bulk
# cleanup must never touch. The same is true of develop, staging and the long
# lived integration branches teams keep.
#
# This is a default, not a policy: `git config cleanup-assistant.protected
# '<regex>'` sets it per repository, which is where the answer actually lives.
#
DEFAULT_PROTECTED_PATTERN='^(main|master|develop|development|staging|production|release/.*|support/.*)$'

DEFAULT_STALE_DAYS=30
DEFAULT_HEIGHT=24
DEFAULT_BASE_REF="origin/main"

UPDATE_REPOSITORY="CodingSteve01/git-cleanup-assistant"
UPDATE_FORMULA="CodingSteve01/tap/git-cleanup-assistant"
UPDATE_CHECK_INTERVAL_SECONDS=86400
UPDATE_STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/git-cleanup-assistant/last-update-check"

# -----------------------------------------------------------------------------
# Temporary workspace
# -----------------------------------------------------------------------------

TMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/git-cleanup-assistant.XXXXXX")"

cleanup_tmp() {
    rm -rf "$TMP_ROOT"
}

trap cleanup_tmp EXIT INT TERM

WORKTREE_DATA="$TMP_ROOT/worktrees.tsv"
WORKTREE_LIST="$TMP_ROOT/worktree-list.txt"
REF_DATA="$TMP_ROOT/refs.tsv"
BRANCH_DATA="$TMP_ROOT/branches.tsv"
PR_CACHE="$TMP_ROOT/pr-cache.tsv"
PR_QUERY="$TMP_ROOT/pr-query.graphql"
PR_RESPONSE="$TMP_ROOT/pr-response.json"
PR_HEADS="$TMP_ROOT/pr-heads.txt"

# -----------------------------------------------------------------------------
# Formatting
# -----------------------------------------------------------------------------

if [[ -t 1 ]]; then
    BOLD=$'\033[1m'
    GREEN=$'\033[32m'
    YELLOW=$'\033[33m'
    RED=$'\033[31m'
    CYAN=$'\033[36m'
    RESET=$'\033[0m'
else
    BOLD=""
    GREEN=""
    YELLOW=""
    RED=""
    CYAN=""
    RESET=""
fi

title() {
    echo
    echo "${BOLD}════════════════════════════════════════════════════════════${RESET}"
    echo "${BOLD}$1${RESET}"
    echo "${BOLD}════════════════════════════════════════════════════════════${RESET}"
}

success() {
    echo "${GREEN}✓ $*${RESET}"
}

warning() {
    echo "${YELLOW}⚠ $*${RESET}"
}

info() {
    echo "${CYAN}ℹ $*${RESET}"
}

error() {
    echo "${RED}✗ $*${RESET}"
}

die() {
    error "$*"
    exit 1
}

# -----------------------------------------------------------------------------
# Generic helpers
# -----------------------------------------------------------------------------

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

require_git_repository() {
    git rev-parse --git-dir >/dev/null 2>&1 ||
        die "This script must be run inside a Git repository."
}

confirm() {
    gum confirm "$1"
}

menu() {
    local header="$1"
    shift

    printf '%s\n' "$@" |
        gum choose \
            --height "$MENU_HEIGHT" \
            --header "$header"
}

input_value() {
    local placeholder="$1"
    local value="$2"

    gum input \
        --placeholder "$placeholder" \
        --value "$value"
}

plural_verb() {
    [[ "$1" -eq 1 ]] && echo "needs" || echo "need"
}

#
# Set once per scan by refresh_repository_state. Reading the clock per branch and
# per worktree started a process for every age in the list and could not report a
# different answer.
#
NOW_EPOCH="$(date +%s)"

age_in_days() {
    local epoch="$1"

    if [[ -z "$epoch" || "$epoch" == "0" ]]; then
        echo "?"
        return
    fi

    echo $(( (NOW_EPOCH - epoch) / 86400 ))
}

# -----------------------------------------------------------------------------
# Dependency bootstrap
# -----------------------------------------------------------------------------

ensure_homebrew() {
    if command -v brew >/dev/null 2>&1; then
        return
    fi

    echo "Homebrew is required to install dependencies."

    read -r -p "Install Homebrew now? [y/N] " answer

    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "Homebrew is required. Aborting."
        exit 1
    fi

    /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Apple Silicon Homebrew may not yet be in PATH in the current shell.
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi

    command_exists brew ||
        die "Homebrew was installed but is not available in PATH."
}

ensure_or_update_formula() {
    local command="$1"
    local formula="$2"
    local label="$3"

    if ! command -v "$command" >/dev/null 2>&1; then
        echo "$label is not installed."

        read -r -p "Install $label now? [Y/n] " answer
        answer="${answer:-y}"

        if [[ "$answer" =~ ^[Yy]$ ]]; then
            brew install "$formula"
        else
            echo "$label is required. Aborting."
            exit 1
        fi

        return
    fi

    # Check whether Homebrew manages this installation.
    if brew list --formula "$formula" >/dev/null 2>&1; then
        if brew outdated --formula "$formula" | grep -qx "$formula"; then
            echo "$label has an update available."

            read -r -p "Update $label now? [Y/n] " answer
            answer="${answer:-y}"

            if [[ "$answer" =~ ^[Yy]$ ]]; then
                brew upgrade "$formula"
            fi
        fi
    else
        echo "$label is installed, but not managed by Homebrew."
        echo "Leaving the existing installation untouched."
    fi
}

#
# gum draws the interface, so it is required. gh is not: every rung of the
# evidence ladder that clears a branch on its own comes from git, so a run
# without any forge still classifies branches. What a forge adds is knowing
# whether a pull request is still open, which only refines "abandoned".
#
ensure_dependencies() {
    if ! command_exists gum; then
        if [[ "$(uname -s)" != "Darwin" ]]; then
            die "Please install 'gum' first; automatic setup supports macOS only."
        fi

        ensure_homebrew
        ensure_or_update_formula gum gum "Gum"
    fi

    if command_exists gh; then
        # Keep an existing installation current, but never insist on one.
        if command_exists brew; then
            ensure_or_update_formula gh gh "GitHub CLI"
        fi

        return
    fi

    if [[ "$(uname -s)" != "Darwin" ]] || ! command_exists brew; then
        return
    fi

    echo "GitHub CLI is not installed. It is optional: it adds pull request"
    echo "state to the branch list. Everything else works without it."

    read -r -p "Install it now? [Y/n] " answer
    answer="${answer:-y}"

    if [[ "$answer" =~ ^[Yy]$ ]]; then
        brew install gh
    fi
}

ensure_github_auth() {
    GH_AVAILABLE=false

    if ! command_exists gh; then
        return
    fi

    if gh auth status >/dev/null 2>&1; then
        GH_AVAILABLE=true
        return
    fi

    title "GitHub Authentication"

    warning "GitHub CLI is installed but not authenticated."
    echo
    echo "GitHub authentication enables reliable detection of merged"
    echo "pull requests, including squash merges."
    echo

    if confirm "Run 'gh auth login' now?"; then
        gh auth login

        if gh auth status >/dev/null 2>&1; then
            GH_AVAILABLE=true
            success "GitHub authentication is available."
        else
            warning "GitHub authentication is still unavailable."
        fi
    else
        warning "Continuing without GitHub PR information."
    fi
}

# -----------------------------------------------------------------------------
# Update checking
# -----------------------------------------------------------------------------

#
# Compares two dotted versions and succeeds when the first one is strictly newer.
# The field sort keeps 0.10.0 above 0.2.0 without relying on GNU sort -V.
#
version_is_newer() {
    local candidate="$1"
    local current="$2"

    [[ "$candidate" == "$current" ]] && return 1

    local newest
    newest="$(
        printf '%s\n%s\n' "$candidate" "$current" |
            sort -t. -k1,1n -k2,2n -k3,3n |
            tail -1
    )"

    [[ "$newest" == "$candidate" ]]
}

update_check_is_due() {
    [[ -f "$UPDATE_STATE_FILE" ]] || return 0

    local last
    last="$(cat "$UPDATE_STATE_FILE" 2>/dev/null || echo 0)"

    [[ "$last" =~ ^[0-9]+$ ]] || return 0

    (( $(date +%s) - last >= UPDATE_CHECK_INTERVAL_SECONDS ))
}

record_update_check() {
    mkdir -p "$(dirname "$UPDATE_STATE_FILE")" 2>/dev/null || return 0
    date +%s > "$UPDATE_STATE_FILE" 2>/dev/null || true
}

installed_via_homebrew() {
    command_exists brew && brew list --formula git-cleanup-assistant >/dev/null 2>&1
}

#
# Runs at most once a day and never blocks the session: a missing release, a
# rate-limited API or no network all leave the assistant running as before.
# Set GIT_CLEANUP_ASSISTANT_NO_UPDATE_CHECK=1 to skip it entirely.
#
check_for_update() {
    [[ "${GIT_CLEANUP_ASSISTANT_NO_UPDATE_CHECK:-0}" == "1" ]] && return
    [[ "$GH_AVAILABLE" == true ]] || return
    update_check_is_due || return

    local latest
    latest="$(
        gh api "repos/$UPDATE_REPOSITORY/releases/latest" \
            --jq '.tag_name' \
            2>/dev/null |
            sed 's/^v//'
    )"

    record_update_check

    [[ -n "$latest" ]] || return
    version_is_newer "$latest" "$VERSION" || return

    title "Update Available"

    echo "Installed: $VERSION"
    echo "Latest:    $latest"
    echo
    echo "https://github.com/$UPDATE_REPOSITORY/releases/tag/v$latest"
    echo

    if ! installed_via_homebrew; then
        info "This copy is not managed by Homebrew; update it the way you installed it."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    if ! confirm "Update to $latest now?"; then
        return
    fi

    if ! brew upgrade "$UPDATE_FORMULA"; then
        warning "The update failed; continuing with $VERSION."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    #
    # Bash reads a script incrementally, so continuing inside a file that
    # Homebrew has just replaced is not safe. Hand over to the new copy instead.
    #
    local replacement
    replacement="$(command -v git-cleanup-assistant || true)"

    if [[ -n "$replacement" ]]; then
        success "Updated to $latest; restarting."
        exec "$replacement" "$@"
    fi

    success "Updated to $latest; start the assistant again to use it."
    exit 0
}

# -----------------------------------------------------------------------------
# Repository information
# -----------------------------------------------------------------------------

#
# Repository configuration wins over the built-in default, and the environment
# wins over both, so a one-off run can widen or narrow it without editing config.
#
resolve_protected_pattern() {
    local configured

    if [[ -n "${GIT_CLEANUP_ASSISTANT_PROTECTED:-}" ]]; then
        PROTECTED_PATTERN="$GIT_CLEANUP_ASSISTANT_PROTECTED"
        return
    fi

    configured="$(git config --get cleanup-assistant.protected 2>/dev/null || true)"

    if [[ -n "$configured" ]]; then
        PROTECTED_PATTERN="$configured"
        return
    fi

    PROTECTED_PATTERN="$DEFAULT_PROTECTED_PATTERN"
}

branch_is_protected() {
    local branch="$1"

    [[ -n "$branch" ]] || return 1
    [[ "$branch" == "(detached)" ]] && return 1

    printf '%s' "$branch" | grep -Eq "${PROTECTED_PATTERN:-$DEFAULT_PROTECTED_PATTERN}"
}

initialize_repository() {
    require_git_repository

    REPO_ROOT="$(git rev-parse --show-toplevel)"

    resolve_protected_pattern

    # So the shared lookups have a file to read before the first scan runs.
    refresh_worktree_list

    PRIMARY_WORKTREE="$(
        git worktree list --porcelain |
            awk '/^worktree / { print substr($0, 10); exit }'
    )"

    PRIMARY_BRANCH="$(
        git -C "$PRIMARY_WORKTREE" branch --show-current 2>/dev/null || true
    )"

    REPO_SLUG=""
    REPO_OWNER=""
    REPO_NAME=""

    if [[ "$GH_AVAILABLE" == true ]]; then
        REPO_SLUG="$(
            gh repo view \
                --json nameWithOwner \
                --jq '.nameWithOwner' \
                2>/dev/null || true
        )"

        REPO_OWNER="${REPO_SLUG%%/*}"
        REPO_NAME="${REPO_SLUG##*/}"
    fi
}

# -----------------------------------------------------------------------------
# GitHub PR cache
# -----------------------------------------------------------------------------

#
# How many branch heads go into one GraphQL request.
#
# The query carries one aliased field per branch, so the request grows with the
# number of branches asked about. Fifty keeps a request small enough to stay well
# inside GitHub's node limit while still turning a normal repository into a
# single round trip.
#
PR_QUERY_BATCH_SIZE=50

#
# GraphQL string literals take the branch name verbatim, so the two characters
# that could end the literal early are escaped here.
#
escape_for_graphql() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

#
# Collects the branch heads worth asking about: the local branches, which is
# also every branch a worktree can have checked out.
#
collect_pr_heads() {
    git for-each-ref --format='%(refname:short)' refs/heads > "$PR_HEADS"
}

#
# Asks GitHub about one batch of branch heads in a single request.
#
# pullRequests(headRefName:) is the field that makes this work. Looking the
# branch up as a ref would find nothing for exactly the branches that matter
# here, because a merged pull request usually takes its remote branch with it.
# A pull request keeps its head ref name forever.
#
# Merged wins over the newest. One branch head can carry several pull requests
# over its lifetime, and a closed re-open or a revert experiment created after
# the merge would otherwise report "closed" for work that is on main, which is
# how the assistant ends up refusing the very deletion it was asked for.
#
query_pr_batch() {
    local first="$1"
    local last="$2"

    local index="$first"
    local branch
    local escaped

    {
        printf 'query {\n'
        printf '  repository(owner: "%s", name: "%s") {\n' \
            "$REPO_OWNER" "$REPO_NAME"

        while [[ "$index" -le "$last" ]]; do
            branch="$(sed -n "${index}p" "$PR_HEADS")"

            [[ -z "$branch" ]] && { index=$((index + 1)); continue; }

            escaped="$(escape_for_graphql "$branch")"

            printf '    b%s: pullRequests(headRefName: "%s", first: 10, states: [OPEN, CLOSED, MERGED], orderBy: {field: CREATED_AT, direction: DESC}) { nodes { number state url merged } }\n' \
                "$index" "$escaped"

            index=$((index + 1))
        done

        printf '  }\n'
        printf '}\n'
    } > "$PR_QUERY"

    #
    # Filtered by gh's own --jq rather than a jq binary, so this adds no
    # dependency the assistant did not already have.
    #
    # Aliases carry the line number the branch had in PR_HEADS, which is how an
    # answer finds its way back to a name without that name having to survive a
    # round trip through GraphQL field syntax.
    #
    # $line and $pr below are jq bindings, not shell variables.
    # shellcheck disable=SC2016
    gh api graphql -F query=@"$PR_QUERY" --jq '
        .data.repository // {}
        | to_entries[]
        | select(.value.nodes | length > 0)
        | .key[1:] as $line
        | (
            (.value.nodes | map(select(.merged == true)) | first)
            // .value.nodes[0]
          ) as $pr
        | [
            $line,
            (if $pr.merged then "merged" else ($pr.state | ascii_downcase) end),
            ($pr.number | tostring),
            $pr.url
          ]
        | @tsv
    ' > "$PR_RESPONSE" 2>/dev/null || return 1

    local line
    local state
    local number
    local url

    while IFS=$'\t' read -r line state number url; do
        [[ -z "$line" ]] && continue

        printf '%s\t%s\t%s\t%s\n' \
            "$(sed -n "${line}p" "$PR_HEADS")" "$state" "$number" "$url"
    done < "$PR_RESPONSE" >> "$PR_CACHE"
}

#
# Asks the forge about the branches that exist here, rather than downloading the
# repository's pull request history.
#
# Listing every pull request cost one request per hundred of them, forever, and
# it bought nothing: a repository with 2500 pull requests and 70 local branches
# spent seventeen seconds fetching 2430 answers about branches that are not on
# this machine, on every start and every refresh. The cost now follows the number
# of local branches, which is the number the user can actually see.
#
# Everything here is optional by design. A failed request leaves the cache empty
# and the run continues on git evidence alone, which is the same path a machine
# without gh takes.
#
refresh_pr_cache() {
    : > "$PR_CACHE"

    if [[ "$GH_AVAILABLE" != true || -z "$REPO_OWNER" || -z "$REPO_NAME" ]]; then
        return
    fi

    collect_pr_heads

    local total
    total=$(count_rows "$PR_HEADS")

    if [[ "$total" -eq 0 ]]; then
        return
    fi

    local first=1
    local last
    local failed=0

    while [[ "$first" -le "$total" ]]; do
        last=$((first + PR_QUERY_BATCH_SIZE - 1))
        [[ "$last" -gt "$total" ]] && last="$total"

        #
        # Printed rather than spun, because a spinner has to wrap the work to
        # mean anything and gum spin cannot call a shell function. A batch is
        # one request, so the line moves at the speed of the work behind it.
        #
        if [[ "$total" -gt "$PR_QUERY_BATCH_SIZE" ]]; then
            printf '\r  Reading pull request state: %s-%s of %s' \
                "$first" "$last" "$total"
        fi

        query_pr_batch "$first" "$last" || failed=$((failed + 1))

        first=$((last + 1))
    done

    [[ "$total" -gt "$PR_QUERY_BATCH_SIZE" ]] && printf '\r%*s\r' 60 ""

    if [[ "$failed" -gt 0 ]]; then
        warning "$failed pull request request(s) failed; classification falls back to git."
    fi

    info "Read pull request state for $(count_rows "$PR_CACHE") of $total local branches."
}

pr_info_for_branch() {
    local branch="$1"

    if [[ ! -s "$PR_CACHE" ]]; then
        printf 'unknown\t\t'
        return
    fi

    awk -F '\t' -v branch="$branch" '
        $1 == branch {
            print $2 "\t" $3 "\t" $4
            found = 1
            exit
        }

        END {
            if (!found) {
                print "none\t\t"
            }
        }
    ' "$PR_CACHE"
}

# -----------------------------------------------------------------------------
# Worktree scanning
# -----------------------------------------------------------------------------

#
# Re-reads the porcelain worktree list into a file the lookups below share.
#
# Every one of those lookups used to run `git worktree list` itself, and they run
# per branch and per worktree: a repository with 70 branches and 36 worktrees
# asked git the same question over a hundred times per scan. Reading it once and
# querying the file costs one git process instead.
#
# It is re-read rather than cached for the run, because a worktree can appear or
# be removed between a scan and an action, and the actions call this first.
#
refresh_worktree_list() {
    git worktree list --porcelain > "$WORKTREE_LIST" 2>/dev/null || : > "$WORKTREE_LIST"
}

worktree_is_locked() {
    local target="$1"

    awk -v target="$target" '
            /^worktree / {
                current = substr($0, 10)
            }

            current == target && /^locked/ {
                found = 1
            }

            END {
                exit !found
            }
        ' "$WORKTREE_LIST"
}

worktree_is_dirty() {
    local target="$1"

    [[ -n "$(
        git -C "$target" \
            status --porcelain --ignore-submodules=none \
            2>/dev/null
    )" ]]
}

#
# How many worktrees are inspected at once.
#
# `git status` is by far the most expensive thing this tool does — in a
# repository with 36 worktrees it was 15 of the scan's 19 seconds — and it is
# dominated by waiting on the filesystem, not by CPU. Running a handful at a time
# turns that wait into overlap. The cap keeps a large worktree set from starting
# 36 full status walks against one disk at once.
#
default_probe_limit() {
    local cpus

    cpus="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)"

    [[ "$cpus" =~ ^[0-9]+$ ]] || cpus=4
    [[ "$cpus" -gt 6 ]] && cpus=6
    [[ "$cpus" -lt 1 ]] && cpus=1

    echo "$cpus"
}

#
# Reads committer date, upstream and tracking state for every local branch in one
# call.
#
# Worktrees share the repository's refs, so this is the same answer that running
# `git log -1` and `git for-each-ref` inside each worktree produced, at one git
# process instead of three per worktree. Measured on the repository that prompted
# this: 4.5 seconds down to 0.04.
#
write_ref_metadata() {
    git for-each-ref \
        --format='%(refname:short)%09%(committerdate:short)%09%(committerdate:unix)%09%(upstream:short)%09%(upstream:track)' \
        refs/heads > "$REF_DATA"
}

ref_metadata_field() {
    local branch="$1"
    local column="$2"

    awk -F '\t' -v branch="$branch" -v column="$column" '
        $1 == branch {
            print $column
            exit
        }
    ' "$REF_DATA"
}

#
# Answers "is this worktree dirty?" for every worktree, a few at a time.
#
# Each probe writes its own file rather than appending to a shared one, so no
# result can be interleaved with another.
#
probe_dirty_states() {
    local paths="$1"
    local out="$2"

    local limit
    local running=0
    local index=0
    local total
    local path

    limit="$(default_probe_limit)"
    total=$(count_rows "$paths")

    rm -f "$TMP_ROOT"/dirty-probe.* 2>/dev/null || true
    : > "$out"

    while IFS= read -r path; do
        [[ -z "$path" ]] && continue

        index=$((index + 1))

        probe_one_dirty_state "$path" "$TMP_ROOT/dirty-probe.$index" &

        running=$((running + 1))

        if [[ "$running" -ge "$limit" ]]; then
            wait
            running=0
            show_scan_progress "Reading worktrees" "$index" "$total"
        fi
    done < "$paths"

    wait

    show_scan_progress "Reading worktrees" "$total" "$total"

    cat "$TMP_ROOT"/dirty-probe.* > "$out" 2>/dev/null || : > "$out"
    rm -f "$TMP_ROOT"/dirty-probe.* 2>/dev/null || true
}

probe_one_dirty_state() {
    local path="$1"
    local out="$2"

    if [[ -n "$(
        git -C "$path" status --porcelain --ignore-submodules=none 2>/dev/null
    )" ]]; then
        printf '%s\tDIRTY\n' "$path" > "$out"
    else
        printf '%s\tCLEAN\n' "$path" > "$out"
    fi
}

dirty_state_of() {
    local path="$1"
    local states="$2"

    awk -F '\t' -v path="$path" '
        $1 == path {
            print $2
            exit
        }
    ' "$states"
}

#
# Turns the porcelain worktree list into one record per worktree: path, branch
# and whether git holds it locked. All three are in the list already, so no git
# process is needed per worktree to read them.
#
parse_worktree_list() {
    local out="$1"

    awk -v primary="$PRIMARY_WORKTREE" '
        function flush() {
            if (path != "" && path != primary) {
                printf "%s\t%s\t%s\n", path, (branch == "" ? "(detached)" : branch), locked
            }

            path = ""
            branch = ""
            locked = "false"
        }

        /^worktree / {
            flush()
            path = substr($0, 10)
            next
        }

        /^branch refs\/heads\// {
            # "branch refs/heads/" is 18 characters, so the name starts at 19.
            branch = substr($0, 19)
            next
        }

        /^locked/ {
            locked = "true"
            next
        }

        END {
            flush()
        }
    ' "$WORKTREE_LIST" > "$out"
}

scan_worktrees() {
    : > "$WORKTREE_DATA"

    refresh_worktree_list
    write_ref_metadata

    local records="$TMP_ROOT/worktree-records.tsv"
    local paths="$TMP_ROOT/worktree-paths.txt"
    local states="$TMP_ROOT/worktree-dirty.tsv"

    parse_worktree_list "$records"
    cut -f1 "$records" > "$paths"

    probe_dirty_states "$paths" "$states"

    local index=0

    local path
    local branch
    local locked
    local date
    local epoch
    local age
    local track
    local gone
    local state
    local pr_state
    local pr_number
    local pr_url
    local pr_info

    while IFS=$'\t' read -r path branch locked; do
        [[ -z "$path" ]] && continue
        [[ ! -d "$path" ]] && continue

        index=$((index + 1))

        date="unknown"
        epoch="0"
        gone=false

        if [[ "$branch" != "(detached)" ]]; then
            date="$(ref_metadata_field "$branch" 2)"
            epoch="$(ref_metadata_field "$branch" 3)"
            track="$(ref_metadata_field "$branch" 5)"

            [[ -z "$date" ]] && date="unknown"
            [[ -z "$epoch" ]] && epoch="0"

            if [[ "$track" == *"[gone]"* ]]; then
                gone=true
            fi
        fi

        age="$(age_in_days "$epoch")"

        if [[ "$locked" == "true" ]]; then
            state="LOCKED"
        elif [[ "$(dirty_state_of "$path" "$states")" == "DIRTY" ]]; then
            state="DIRTY"
        else
            state="CLEAN"
        fi

        pr_state="unknown"
        pr_number=""
        pr_url=""

        if [[ "$branch" != "(detached)" ]]; then
            pr_info="$(pr_info_for_branch "$branch")"

            IFS=$'\t' read -r pr_state pr_number pr_url <<EOF
$pr_info
EOF
        fi

        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "W$(printf '%05d' "$index")" \
            "$path" \
            "$branch" \
            "$date" \
            "$age" \
            "$state" \
            "$gone" \
            "$pr_state" \
            "$pr_number" \
            "$pr_url" \
            "$epoch" \
            >> "$WORKTREE_DATA"
    done < "$records"

    clear_scan_progress
}

# -----------------------------------------------------------------------------
# Branch scanning
# -----------------------------------------------------------------------------

branch_is_checked_out() {
    local branch="$1"

    [[ -n "$(branch_worktree_path "$branch")" ]]
}

#
# Git refuses to delete a branch that any worktree has checked out, and that is
# the one refusal the user cannot resolve by forcing. Report the path so the
# message names the worktree that has to go first.
#
branch_worktree_path() {
    local branch="$1"

    awk -v ref="refs/heads/$branch" '
            /^worktree / {
                current = substr($0, 10)
            }

            $1 == "branch" && $2 == ref {
                print current
                exit
            }
        ' "$WORKTREE_LIST"
}

branch_field() {
    local id="$1"
    local column="$2"

    awk -F '\t' -v id="$id" -v column="$column" '
        $1 == id {
            print $column
            exit
        }
    ' "$BRANCH_DATA"
}

commits_not_on_base() {
    git rev-list --count "$BASE_REF..$1" 2>/dev/null || echo "?"
}

branch_is_merged_into_base() {
    git merge-base --is-ancestor "$1" "$BASE_REF" >/dev/null 2>&1
}

#
# Answers "was this branch squash-merged?" without asking any forge.
#
# A squash merge replaces the branch's commits with one new commit, so the tip is
# never an ancestor of the base ref and every check based on ancestry says no,
# forever. Rolling the branch into a single synthetic commit on top of the merge
# base reproduces the patch the squash produced, and git cherry then finds it on
# the base ref by patch id: a leading "-" means already applied.
#
# This is the strongest evidence available from git alone, which is what keeps
# GitHub optional here rather than load bearing.
#
branch_is_patch_equivalent_to_base() {
    local branch="$1"

    local base
    local tree
    local synthetic

    base="$(git merge-base "$BASE_REF" "$branch" 2>/dev/null)" || return 1
    tree="$(git rev-parse "$branch^{tree}" 2>/dev/null)" || return 1

    [[ -n "$base" && -n "$tree" ]] || return 1

    # Writes one unreferenced commit object, which git gc collects.
    synthetic="$(git commit-tree "$tree" -p "$base" -m _ 2>/dev/null)" || return 1

    [[ "$(git cherry "$BASE_REF" "$synthetic" 2>/dev/null)" == -* ]]
}

scan_branches() {
    : > "$BRANCH_DATA"

    local index=0
    local total

    total=$(git for-each-ref --format='%(refname:short)' refs/heads | wc -l | tr -d ' ')

    git for-each-ref \
        --sort=committerdate \
        --format='%(refname:short)%09%(committerdate:short)%09%(committerdate:unix)%09%(upstream:short)%09%(upstream:track)' \
        refs/heads |
        while IFS=$'\t' read -r branch date epoch upstream track; do
            [[ "$branch" == "$PRIMARY_BRANCH" ]] && continue

            index=$((index + 1))

            show_scan_progress "Classifying branches" "$index" "$total"

            local age
            local gone=false
            local checked_out=false
            local git_merged=false
            local squash_merged=false
            local pr_state
            local pr_number
            local pr_url
            local pr_info
            local protected

            age="$(age_in_days "$epoch")"

            if [[ "$track" == *"[gone]"* ]]; then
                gone=true
            fi

            if branch_is_checked_out "$branch"; then
                checked_out=true
            fi

            if branch_is_merged_into_base "$branch"; then
                git_merged=true
            fi

            #
            # Only asked when ancestry already said no, and stored so the
            # classification does not recompute it on every pass.
            #
            if [[ "$git_merged" != "true" ]] &&
                branch_is_patch_equivalent_to_base "$branch"
            then
                squash_merged=true
            fi

            pr_info="$(pr_info_for_branch "$branch")"

            IFS=$'\t' read -r pr_state pr_number pr_url <<EOF
$pr_info
EOF

            protected=false

            if branch_is_protected "$branch"; then
                protected=true
            fi

            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "B$(printf '%05d' "$index")" \
                "$branch" \
                "$date" \
                "$age" \
                "$upstream" \
                "$gone" \
                "$checked_out" \
                "$git_merged" \
                "$pr_state" \
                "$pr_number" \
                "$pr_url" \
                "$epoch" \
                "$squash_merged" \
                "$protected" \
                >> "$BRANCH_DATA"
        done

    clear_scan_progress
}

#
# Scanning is the slow part and it has to look like it.
#
# The spinner this replaces ran a `bash -c "exit 0"` next to the scan rather than
# around it: it appeared and vanished, and then the assistant sat silent for the
# fifteen seconds the scan actually took. gum spin cannot wrap a shell function,
# so the scanners report their own progress instead, which also makes the two
# genuinely slow steps visible as what they are — a status call per worktree and
# a patch comparison per unmerged branch.
#
refresh_repository_state() {
    NOW_EPOCH="$(date +%s)"

    scan_worktrees
    scan_branches

    STATE_IS_STALE=false
}

#
# Records that the repository changed under the current scan, so the next menu
# pass re-reads it. Every deletion path calls this.
#
mark_state_stale() {
    STATE_IS_STALE=true
}

#
# Menus used to rescan on every pass through their loop, which meant paying the
# full scan again after cancelling a filter or backing out of a submenu. The
# scan is only repeated when something actually changed.
#
refresh_repository_state_if_stale() {
    [[ "${STATE_IS_STALE:-true}" == true ]] || return 0

    refresh_repository_state
}

show_scan_progress() {
    local label="$1"
    local done_count="$2"
    local total="$3"

    [[ "$total" -gt 0 ]] || return 0

    printf '\r  %s %s/%s' "$label" "$done_count" "$total"
}

clear_scan_progress() {
    printf '\r%*s\r' 60 ""
}

# -----------------------------------------------------------------------------
# Counts / dashboard
# -----------------------------------------------------------------------------

count_rows() {
    local file="$1"

    if [[ ! -s "$file" ]]; then
        echo 0
    else
        wc -l < "$file" | tr -d ' '
    fi
}

count_worktree_state() {
    local state="$1"

    awk -F '\t' -v state="$state" '$6 == state { count++ } END { print count+0 }' \
        "$WORKTREE_DATA"
}

#
# Counts by the evidence ladder, not by one rung of it.
#
# The dashboard used to report "Merged PR", which is the only rung a forge can
# see. A repository full of squash merges therefore showed a small number right
# above a plan that then classified three times as many as merged, and the two
# screens contradicted each other on the one question the user is here to answer.
# Both now count the same way.
#
count_worktree_class() {
    local wanted="$1"

    awk -F '\t' -v wanted="$wanted" '
        FILENAME == branches {
            if ($8 == "true" || $13 == "true") {
                merged_branch[$2] = 1
            }

            if ($14 == "true") {
                protected_branch[$2] = 1
            }

            next
        }

        {
            if (protected_branch[$3] == 1)
                class = "PROTECTED"
            else if ($8 == "merged" || merged_branch[$3] == 1)
                class = "MERGED"
            else if ($7 == "true" && $8 != "open")
                class = "ABANDONED"
            else
                class = "UNCLEAR"

            if (class == wanted) {
                count++
            }
        }

        END {
            print count+0
        }
    ' branches="$BRANCH_DATA" "$BRANCH_DATA" "$WORKTREE_DATA"
}

count_branch_class() {
    local wanted="$1"

    awk -F '\t' -v wanted="$wanted" '
        {
            if ($14 == "true")
                class = "PROTECTED"
            else if ($8 == "true" || $13 == "true" || $9 == "merged")
                class = "MERGED"
            else if ($6 == "true" && $9 != "open")
                class = "ABANDONED"
            else
                class = "UNCLEAR"

            if (class == wanted) {
                count++
            }
        }

        END {
            print count+0
        }
    ' "$BRANCH_DATA"
}

count_branch_gone() {
    awk -F '\t' '$6 == "true" { count++ } END { print count+0 }' \
        "$BRANCH_DATA"
}

count_branch_old() {
    awk -F '\t' -v days="$STALE_DAYS" '
        $4 != "?" && $4 >= days {
            count++
        }

        END {
            print count+0
        }
    ' "$BRANCH_DATA"
}

show_dashboard() {
    clear

    title "Git Cleanup Assistant"

    echo "Repository:      $REPO_ROOT"
    echo "Primary branch:  $PRIMARY_BRANCH"
    echo "Base ref:        $BASE_REF"
    echo

    if [[ "$GH_AVAILABLE" == true ]]; then
        echo "GitHub:          ${GREEN}enabled${RESET}"
    else
        echo "GitHub:          ${YELLOW}unavailable${RESET} (git evidence only)"
    fi

    echo
    printf "%-18s %8s  %8s\n" "" "WORKTREES" "BRANCHES"
    printf "%-18s %8s  %8s\n" \
        "Total" \
        "$(count_rows "$WORKTREE_DATA")" \
        "$(count_rows "$BRANCH_DATA")"
    printf "%-18s %8s  %8s\n" \
        "Merged" \
        "$(count_worktree_class MERGED)" \
        "$(count_branch_class MERGED)"
    printf "%-18s %8s  %8s\n" \
        "Abandoned" \
        "$(count_worktree_class ABANDONED)" \
        "$(count_branch_class ABANDONED)"
    printf "%-18s %8s  %8s\n" \
        "Unclear" \
        "$(count_worktree_class UNCLEAR)" \
        "$(count_branch_class UNCLEAR)"

    echo
    printf "%-18s %8s\n" "Dirty worktrees" "$(count_worktree_state DIRTY)"
    printf "%-18s %8s\n" "Locked worktrees" "$(count_worktree_state LOCKED)"
    printf "%-18s %8s\n" "Older than ${STALE_DAYS}d" "$(count_branch_old)"

    echo
}

# -----------------------------------------------------------------------------
# Worktree display
# -----------------------------------------------------------------------------

#
# Looks a branch up in the branch scan by name rather than by id, which is how a
# worktree reaches the merge evidence gathered for the branch it has checked out.
#
branch_data_field_by_name() {
    local branch="$1"
    local column="$2"

    awk -F '\t' -v branch="$branch" -v column="$column" '
        $2 == branch {
            print $column
            exit
        }
    ' "$BRANCH_DATA"
}

#
# The same evidence ladder the branches use, applied to the worktree that holds
# one.
#
# It used to be a different question here: worktrees were sorted into "safe",
# "candidates" and "dirty" while branches were sorted into merged, abandoned and
# unclear, so the same finished work was described two ways in two menus and
# neither list said what the other would do about it. A worktree is a checkout of
# a branch, and the reason to remove it is the reason that branch is finished.
#
#   PROVEN     the branch is on the base ref: by ancestry, by patch after a
#              squash merge, or by a merged pull request
#   ABANDONED  the remote branch was deleted and no pull request is open
#   UNKNOWN    no signal either way
#
# The state is carried as a suffix, because it decides how the removal is
# confirmed rather than whether the worktree is a candidate: ":DIRTY" and
# ":LOCKED" are never removed in bulk, whatever the evidence says.
#
classify_worktree() {
    local id="$1"

    local branch
    local state
    local gone
    local pr
    local git_merged
    local squash_merged
    local class

    branch="$(worktree_field "$id" 3)"
    state="$(worktree_field "$id" 6)"
    gone="$(worktree_field "$id" 7)"
    pr="$(worktree_field "$id" 8)"

    if branch_is_protected "$branch"; then
        echo "PROTECTED"
        return
    fi

    git_merged="$(branch_data_field_by_name "$branch" 8)"
    squash_merged="$(branch_data_field_by_name "$branch" 13)"

    if [[ "$pr" == "merged" ||
        "$git_merged" == "true" ||
        "$squash_merged" == "true" ]]
    then
        class="PROVEN"
    elif [[ "$gone" == "true" && "$pr" != "open" ]]; then
        class="ABANDONED"
    else
        class="UNKNOWN"
    fi

    [[ "$state" != "CLEAN" ]] && class="$class:$state"

    echo "$class"
}

worktree_field() {
    local id="$1"
    local column="$2"

    awk -F '\t' -v id="$id" -v column="$column" '
        $1 == id {
            print $column
            exit
        }
    ' "$WORKTREE_DATA"
}

#
# One list, in the same shape the branch list has: the class first, then what
# decides how a removal is confirmed, then age, branch and path. Typing MERGED,
# ABANDONED, UNCLEAR, DIRTY or LOCKED narrows it, which is what the four
# overlapping modes were trying to be.
#
#
# One list, in the same shape the branch list has: the class first, then what
# decides how a removal is confirmed, then age, branch and path. Typing MERGED,
# ABANDONED, UNCLEAR, DIRTY or LOCKED narrows it, which is what the four
# overlapping modes were trying to be.
#
worktree_display_rows() {
    #
    # Reads the branch scan first, so the merge evidence gathered per branch —
    # ancestry and patch equivalence, not just the pull request — decides the
    # label here too. A worktree and the branch it holds can no longer be
    # described differently in two lists.
    #
    awk -F '\t' '
        FILENAME == branches {
            if ($8 == "true" || $13 == "true") {
                merged_branch[$2] = 1
            }

            if ($14 == "true") {
                protected_branch[$2] = 1
            }

            next
        }

        {
            id=$1
            path=$2
            branch=$3
            age=$5
            state=$6
            gone=$7
            pr=$8

            if (protected_branch[branch] == 1)
                class = "PROTECTED"
            else if (pr == "merged" || merged_branch[branch] == 1)
                class = "MERGED"
            else if (gone == "true" && pr != "open")
                class = "ABANDONED"
            else
                class = "UNCLEAR"

            printf "%s | %-9s | %-6s | %4sd | %s | %s\n",
                id,
                class,
                (state == "CLEAN" ? "-" : state),
                age,
                branch,
                path
        }
    ' branches="$BRANCH_DATA" "$BRANCH_DATA" "$WORKTREE_DATA"
}

#
# Candidates start selected.
#
# Picking twenty worktrees out of a filter one Tab at a time is the step that
# stops a cleanup from happening at all, and the tool already knows which ones it
# would suggest. Deselecting the two you want to keep is the shorter path to the
# same answer, and nothing is removed before the plan has been shown anyway.
#
select_worktrees() {
    local rows
    local preselected

    rows="$(worktree_display_rows)"

    if [[ -z "$rows" ]]; then
        warning "No worktrees besides the primary one."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return 1
    fi

    preselected="$(
        printf '%s\n' "$rows" |
            awk -F ' \\| ' '
                $2 ~ /^ *(MERGED|ABANDONED) *$/ && $3 ~ /^ *- *$/ {
                    print $0
                }
            ' |
            paste -sd, -
    )"

    printf '%s\n' "$rows" |
        gum filter \
            --no-limit \
            --height "$LIST_HEIGHT" \
            --selected "$preselected" \
            --header "Merged and abandoned clean worktrees start selected. Tab toggles, Enter confirms. Type MERGED, ABANDONED, UNCLEAR, DIRTY or LOCKED to narrow." \
            --placeholder "Filter worktrees..."
}

selected_ids() {
    sed -E 's/^([^ ]+).*/\1/'
}

#
# Reads a newline separated list of ids into SELECTED_IDS, so callers can walk a
# selection with a for loop.
#
# This exists because `while read ... done < list` is the wrong shape for a loop
# whose body asks a question. The loop owns stdin for as long as it runs, so the
# first gum prompt inside it reads the remaining ids as keystrokes, answers
# itself with them and returns instantly for everything after the first entry.
# Selecting twenty branches and watching one of them disappear was that bug, not
# a deletion that was refused. An array holds the list without holding stdin.
#
load_ids() {
    local raw="$1"
    local line

    SELECTED_IDS=()

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" ]] && continue
        SELECTED_IDS[${#SELECTED_IDS[@]}]="$line"
    done <<< "$raw"
}

#
# `set -u` treats an empty array as unset in Bash 3.2, which is the version
# macOS ships, so every expansion of a possibly empty selection goes through
# this instead of "${SELECTED_IDS[@]}".
#
selected_count() {
    echo "${#SELECTED_IDS[@]}"
}

show_worktree_details() {
    local ids="$1"
    local detail_file="$TMP_ROOT/worktree-details.txt"

    : > "$detail_file"

    local id

    load_ids "$ids"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        awk -F '\t' -v id="$id" '
            $1 == id {
                print "────────────────────────────────────────────────────────────"
                print $3
                print ""
                print "Path:        " $2
                print "Last commit: " $4 " (" $5 " days ago)"
                print "State:       " $6
                print "Gone:        " $7
                print "PR state:    " $8

                if ($9 != "") {
                    print "PR number:   #" $9
                }

                if ($10 != "") {
                    print "PR URL:      " $10
                }

                print ""
            }
        ' "$WORKTREE_DATA" >> "$detail_file"

        local path
        path="$(awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$WORKTREE_DATA")"

        if [[ -d "$path" ]]; then
            echo "Status:" >> "$detail_file"
            git -C "$path" status --short --ignore-submodules=none \
                >> "$detail_file" 2>&1 || true
            echo >> "$detail_file"

            echo "Recent commits:" >> "$detail_file"
            git -C "$path" log \
                -5 \
                --date=short \
                --format='%h %ad %s' \
                >> "$detail_file" 2>&1 || true

            echo >> "$detail_file"
        fi
    done

    gum pager < "$detail_file"
}

#
# One action for a whole worktree selection, with the same shape as the branch
# plan: sort by evidence, show what will happen, ask once for everything the
# ladder cleared, and hold back what needs a decision.
#
# The old flow asked which of four overlapping modes to enter, then which of
# three actions to run inside it, and quietly dropped whatever the chosen action
# did not cover. Nothing in that sequence was a question the user had the
# information to answer.
#
plan_worktree_removals() {
    local ids="$1"

    local proven="$TMP_ROOT/wt-plan-proven.txt"
    local abandoned="$TMP_ROOT/wt-plan-abandoned.txt"
    local unknown="$TMP_ROOT/wt-plan-unknown.txt"
    local held="$TMP_ROOT/wt-plan-held.txt"
    local kept="$TMP_ROOT/wt-plan-kept.txt"

    : > "$proven"
    : > "$abandoned"
    : > "$unknown"
    : > "$held"
    : > "$kept"

    local id
    local class

    load_ids "$ids"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        class="$(classify_worktree "$id")"

        #
        # A dirty or locked worktree is never removed in bulk, whatever the
        # evidence says: the evidence is about the branch, and what is at stake
        # here is uncommitted work.
        #
        case "$class" in
            PROTECTED*)       echo "$id" >> "$kept" ;;
            *:DIRTY|*:LOCKED) echo "$id" >> "$held" ;;
            PROVEN)           echo "$id" >> "$proven" ;;
            ABANDONED)        echo "$id" >> "$abandoned" ;;
            *)                echo "$id" >> "$unknown" ;;
        esac
    done

    local proven_count
    local abandoned_count
    local unknown_count
    local held_count
    local kept_count

    proven_count=$(count_rows "$proven")
    abandoned_count=$(count_rows "$abandoned")
    unknown_count=$(count_rows "$unknown")
    held_count=$(count_rows "$held")
    kept_count=$(count_rows "$kept")

    local clearing=$((proven_count + abandoned_count))

    clear
    title "Worktree Removal Plan"

    if [[ "$proven_count" -gt 0 ]]; then
        echo "  ${GREEN}$proven_count${RESET} merged"
        echo "      the branch is already on $BASE_REF"
        echo
    fi

    if [[ "$abandoned_count" -gt 0 ]]; then
        echo "  ${GREEN}$abandoned_count${RESET} abandoned"
        echo "      the remote branch was deleted and no pull request is open"
        echo
    fi

    if [[ "$unknown_count" -gt 0 ]]; then
        echo "  ${YELLOW}$unknown_count${RESET} unclear"
        echo "      no signal either way; confirmed separately"
        echo
    fi

    if [[ "$held_count" -gt 0 ]]; then
        echo "  ${CYAN}$held_count${RESET} dirty or locked"
        echo "      never removed in bulk; reviewed one at a time"
        echo
    fi

    if [[ "$kept_count" -gt 0 ]]; then
        echo "  ${CYAN}$kept_count${RESET} kept"
        echo "      a protected branch is checked out there"
        echo
    fi

    if [[ "$clearing" -eq 0 && "$unknown_count" -eq 0 && "$held_count" -eq 0 ]]; then
        warning "Nothing in this selection can be removed."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    if [[ "$clearing" -gt 0 ]]; then
        echo "Removing a worktree deletes its directory. These have no"
        echo "uncommitted changes, and the branch stays where it is."
        echo

        if confirm "Remove these $clearing worktrees?"; then
            echo
            remove_worktrees_from_list "$proven"
            remove_worktrees_from_list "$abandoned"
        else
            info "Kept all $clearing."
        fi
    fi

    if [[ "$unknown_count" -gt 0 ]]; then
        echo
        warning "$unknown_count worktree(s) carry no evidence that their work landed."
        echo "They are clean, so nothing uncommitted is lost, but the branch may"
        echo "still be unfinished."
        echo

        if confirm "Remove these $unknown_count as well?"; then
            remove_worktrees_from_list "$unknown"
        else
            info "Kept all $unknown_count."
        fi
    fi

    if [[ "$held_count" -gt 0 ]]; then
        local held_id

        load_ids "$(cat "$held")"

        for held_id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
            review_dirty_worktree "$held_id"
        done
    fi

    echo
    gum input --placeholder "Press Enter to continue" >/dev/null
}

#
# Removes a list of worktrees the plan has already authorised. The state is
# re-read per worktree rather than trusted from the scan, because this is the
# point where a wrong answer costs uncommitted work.
#
remove_worktrees_from_list() {
    local list="$1"
    local count=0

    local id
    local path
    local branch

    load_ids "$(cat "$list")"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        path="$(worktree_field "$id" 2)"
        branch="$(worktree_field "$id" 3)"

        refresh_worktree_list

        if [[ "$(worktree_state "$path")" != "CLEAN" ]]; then
            warning "Skipping $branch: the worktree changed since the scan."
            continue
        fi

        if git worktree remove --force "$path"; then
            success "Removed worktree: $branch"
            count=$((count + 1))
            mark_state_stale
        else
            warning "Could not remove: $branch"
        fi
    done

    git worktree prune
    refresh_worktree_list

    [[ "$count" -gt 0 ]] && info "Removed $count worktree(s)."

    return 0
}

review_dirty_worktree() {
    local id="$1"

    local path
    local branch
    local state

    path="$(awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$WORKTREE_DATA")"
    branch="$(awk -F '\t' -v id="$id" '$1 == id { print $3 }' "$WORKTREE_DATA")"
    state="$(awk -F '\t' -v id="$id" '$1 == id { print $6 }' "$WORKTREE_DATA")"

    clear
    title "$branch"

    echo "Path:  $path"
    echo "State: $state"
    echo

    git -C "$path" status --short --ignore-submodules=none || true

    echo

    local action
    action="$(
        menu \
            "What should happen to this worktree?" \
            "Keep" \
            "Show recent commits" \
            "Remove and DISCARD local changes" \
            "Back"
    )"

    case "$action" in
        "Show recent commits")
            git -C "$path" log \
                -15 \
                --date=short \
                --format='%h %ad %s' |
                gum pager
            ;;

        "Remove and DISCARD local changes")
            warning "This will permanently discard local changes."

            if confirm "Really delete worktree '$branch'?"; then
                local typed

                typed="$(
                    gum input \
                        --placeholder "Type DELETE to confirm"
                )"

                if [[ "$typed" == "DELETE" ]]; then
                    if [[ "$state" == "LOCKED" ]]; then
                        git worktree unlock "$path" || true
                    fi

                    git worktree remove --force "$path"
                    git worktree prune
                    refresh_worktree_list
                    mark_state_stale
                else
                    info "Confirmation did not match."
                fi
            fi
            ;;
    esac
}

#
# One list, one action, matching the branch menu.
#
# What stood here asked for a cleanup mode before showing anything — "safe
# candidates", "all candidates", "dirty / locked", "browse all" — and the buckets
# overlapped, so there was no right answer to give. The list carries the class
# and the state, gum filters on both as you type, and the plan decides what
# happens per worktree.
#
worktree_menu() {
    while true; do
        refresh_repository_state_if_stale

        clear
        title "Worktree Cleanup"

        local selected
        local ids

        selected="$(select_worktrees)" || return
        [[ -z "$selected" ]] && return

        ids="$(printf '%s\n' "$selected" | selected_ids)"

        local next
        next="$(
            menu \
                "$(printf '%s\n' "$ids" | wc -l | tr -d ' ') worktree(s) selected" \
                "Remove selected" \
                "Inspect selection" \
                "Back to the list"
        )"

        case "$next" in
            "Remove selected")
                plan_worktree_removals "$ids"
                ;;

            "Inspect selection")
                show_worktree_details "$ids"
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Branch display
# -----------------------------------------------------------------------------

branch_display_rows() {
    awk -F '\t' '
        {
            id=$1
            branch=$2
            age=$4
            gone=$6
            checked=$7
            gitmerged=$8
            pr=$9
            squashed=$13
            protected=$14

            #
            # The same ladder classify_branch walks, minus the worktree rungs it
            # cannot see from here. Both read the same fields, so a label in this
            # list and the group in the plan can never disagree.
            #
            if (protected == "true")
                class = "PROTECTED"
            else if (gitmerged == "true" || squashed == "true" || pr == "merged")
                class = "MERGED"
            else if (gone == "true" && pr != "open")
                class = "ABANDONED"
            else
                class = "UNCLEAR"

            printf "%s | %-9s | %-7s | %4sd | %s\n",
                id,
                class,
                (checked == "true" ? "IN-WT" : "-"),
                age,
                branch
        }
    ' "$BRANCH_DATA"
}

#
# Candidates start selected, for the reason the worktree list does: the tool
# already knows what it would suggest, and Tab-selecting twenty branches out of a
# filter is the step that stops a cleanup from happening.
#
select_branches() {
    local rows
    local preselected

    rows="$(branch_display_rows)"

    if [[ -z "$rows" ]]; then
        warning "No local branches besides ${PRIMARY_BRANCH:-the primary branch}."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return 1
    fi

    preselected="$(
        printf '%s\n' "$rows" |
            awk -F ' \\| ' '$2 ~ /^ *(MERGED|ABANDONED) *$/' |
            paste -sd, -
    )"

    printf '%s\n' "$rows" |
        gum filter \
            --no-limit \
            --height "$LIST_HEIGHT" \
            --selected "$preselected" \
            --header "Merged and abandoned branches start selected. Tab toggles, Enter confirms. Type MERGED, ABANDONED, UNCLEAR or IN-WT to narrow." \
            --placeholder "Filter branches..."
}

show_branch_details() {
    local ids="$1"
    local detail_file="$TMP_ROOT/branch-details.txt"

    : > "$detail_file"

    local id
    local branch

    load_ids "$ids"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        branch="$(
            awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$BRANCH_DATA"
        )"

        awk -F '\t' -v id="$id" '
            $1 == id {
                print "────────────────────────────────────────────────────────────"
                print $2
                print ""
                print "Last commit:   " $3 " (" $4 " days ago)"
                print "Upstream:      " ($5 == "" ? "(none)" : $5)
                print "Gone:          " $6
                print "In worktree:   " $7
                print "Git merged:    " $8
                print "PR state:      " $9

                if ($10 != "") {
                    print "PR number:     #" $10
                }

                if ($11 != "") {
                    print "PR URL:        " $11
                }

                print ""
            }
        ' "$BRANCH_DATA" >> "$detail_file"

        echo "Recent commits:" >> "$detail_file"

        git log \
            "$branch" \
            -5 \
            --date=short \
            --format='%h %ad %s' \
            >> "$detail_file" 2>&1 || true

        echo >> "$detail_file"
    done

    gum pager < "$detail_file"
}

#
# Prints Git's own refusal instead of swallowing it. A bare "Git refused" leaves
# the user without the one piece of information that decides what to do next:
# an unmerged branch needs a forced deletion, a checked-out branch needs its
# worktree removed first, and those two look identical from the outside.
#
report_git_refusal() {
    local branch="$1"
    local output="$2"

    warning "Git refused to delete '$branch':"
    printf '%s\n' "$output" | sed 's/^/    /'
}

worktree_state() {
    local path="$1"

    if worktree_is_locked "$path"; then
        echo "LOCKED"
    elif worktree_is_dirty "$path"; then
        echo "DIRTY"
    else
        echo "CLEAN"
    fi
}

#
# A branch that a worktree has checked out cannot be deleted at all, and no
# amount of forcing changes that. Clearing the worktree is therefore part of
# deleting the branch, not a separate errand in another menu.
#
# The state is read here rather than taken from the scan, because a worktree can
# turn dirty between the scan and this prompt.
#
remove_blocking_worktree() {
    local branch="$1"
    local path
    local state
    local output

    #
    # Re-read rather than taken from the scan: a worktree can appear, vanish or
    # turn dirty between the scan and this prompt, and this is the point where a
    # wrong answer costs uncommitted work.
    #
    refresh_worktree_list

    path="$(branch_worktree_path "$branch")"

    [[ -z "$path" ]] && return 0

    if [[ "$path" == "$PRIMARY_WORKTREE" ]]; then
        warning "'$branch' is checked out in the primary worktree, which always stays."
        return 1
    fi

    state="$(worktree_state "$path")"

    echo
    echo "${BOLD}$branch${RESET}"
    echo "  Worktree: $path"
    echo "  State:    $state"
    echo

    if [[ "$state" == "DIRTY" ]]; then
        git -C "$path" status --short --ignore-submodules=none || true
        echo
        warning "Removing this worktree permanently discards those changes."
    fi

    if ! confirm "Remove the worktree and free '$branch'?"; then
        info "Keeping '$branch'."
        return 1
    fi

    if [[ "$state" == "DIRTY" ]]; then
        local typed
        typed="$(gum input --placeholder "Type DELETE to discard the changes")"

        if [[ "$typed" != "DELETE" ]]; then
            info "Confirmation did not match; keeping '$branch'."
            return 1
        fi
    fi

    if [[ "$state" == "LOCKED" ]]; then
        git worktree unlock "$path" >/dev/null 2>&1 || true
    fi

    if ! output="$(git worktree remove --force "$path" 2>&1)"; then
        warning "Could not remove the worktree at $path:"
        printf '%s\n' "$output" | sed 's/^/    /'
        return 1
    fi

    git worktree prune
    refresh_worktree_list
    mark_state_stale
    success "Removed worktree: $path"
}

#
# Second pass for the branches a worktree pinned during the bulk run. Keeping it
# out of the main loop means a large selection still runs unattended and only
# stops for the few that need a decision.
#
#
# Forced deletion drops the branch label, never the commits, so the hash is
# printed with the command that brings the branch back.
#
force_delete_branch() {
    local branch="$1"
    local reason="${2:-}"

    local hash
    local output

    #
    # Checked here as well as in the plan, because this is the function that
    # actually deletes: every path to a deletion goes through it, so a future
    # caller cannot route around the protection by accident.
    #
    if branch_is_protected "$branch"; then
        warning "Refusing to delete protected branch '$branch'."
        return 1
    fi

    hash="$(git rev-parse --short "$branch" 2>/dev/null || echo "?")"

    if output="$(git branch -D "$branch" 2>&1)"; then
        success "Deleted${reason:+ ($reason)}: $branch  ·  restore: git branch $branch $hash"
        mark_state_stale
        return 0
    fi

    report_git_refusal "$branch" "$output"
    return 1
}

#
# The evidence ladder, strongest rung first.
#
#   PRIMARY    the primary worktree has it checked out; it always stays
#   PROVEN     the work is on the base ref: by ancestry, by patch equivalence
#              after a squash merge, or by a merged pull request
#   ABANDONED  the remote branch was deleted and no pull request is open. Not
#              proof that the work landed, but a deliberate act by whoever
#              deleted it, and carrying out that decision is what this tool is
#              for
#   UNKNOWN    no signal either way
#
# The suffix ":WT" means a worktree still has the branch checked out, so the
# worktree has to go first whatever the rung says.
#
classify_branch() {
    local id="$1"

    local branch
    local git_merged
    local squash_merged
    local gone
    local pr
    local path
    local class

    branch="$(branch_field "$id" 2)"
    gone="$(branch_field "$id" 6)"
    git_merged="$(branch_field "$id" 8)"
    pr="$(branch_field "$id" 9)"
    squash_merged="$(branch_field "$id" 13)"
    path="$(branch_worktree_path "$branch")"

    if [[ -n "$path" && "$path" == "$PRIMARY_WORKTREE" ]]; then
        echo "PRIMARY"
        return
    fi

    #
    # Above every rung of evidence, because the evidence is right and the
    # conclusion is still wrong: a release branch is merged into the base ref and
    # then carries on being a release branch.
    #
    if [[ "$(branch_field "$id" 14)" == "true" ]]; then
        echo "PROTECTED"
        return
    fi

    if [[ "$git_merged" == "true" ||
        "$squash_merged" == "true" ||
        "$pr" == "merged" ]]
    then
        class="PROVEN"
    elif [[ "$gone" == "true" && "$pr" != "open" ]]; then
        class="ABANDONED"
    else
        class="UNKNOWN"
    fi

    [[ -n "$path" ]] && class="$class:WT"

    echo "$class"
}

write_evidence_table() {
    local ids="$1"
    local report="$2"

    {
        printf '%-8s  %-4s  %-6s  %8s  %s\n' \
            "PR" "GONE" "IN-WT" "UNMERGED" "BRANCH"
        printf '%-8s  %-4s  %-6s  %8s  %s\n' \
            "--------" "----" "------" "--------" "------"
    } > "$report"

    local id
    local branch
    local gone
    local pr

    load_ids "$ids"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        branch="$(branch_field "$id" 2)"
        gone="$(branch_field "$id" 6)"
        pr="$(branch_field "$id" 9)"

        printf '%-8s  %-4s  %-6s  %8s  %s\n' \
            "${pr:-unknown}" \
            "$([[ "$gone" == "true" ]] && echo yes || echo no)" \
            "$([[ -n "$(branch_worktree_path "$branch")" ]] && echo yes || echo no)" \
            "$(commits_not_on_base "$branch")" \
            "$branch" \
            >> "$report"
    done
}

#
# One action for the whole selection.
#
# Asking the user to pick a deletion strategy up front was the reason a run could
# end with nothing deleted: a mixed selection has no single right strategy, and
# whichever one was chosen silently dropped the branches it did not cover. The
# assistant already knows per branch what applies, so it decides, shows the plan,
# and asks only where the answer costs something.
#
delete_selected_branches() {
    local ids="$1"

    local proven="$TMP_ROOT/plan-proven.txt"
    local abandoned="$TMP_ROOT/plan-abandoned.txt"
    local unknown="$TMP_ROOT/plan-unknown.txt"
    local kept="$TMP_ROOT/plan-kept.txt"
    local report="$TMP_ROOT/plan-evidence.txt"

    : > "$proven"
    : > "$abandoned"
    : > "$unknown"
    : > "$kept"

    local blocked=0

    local id
    local class

    load_ids "$ids"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        class="$(classify_branch "$id")"

        [[ "$class" == *:WT ]] && blocked=$((blocked + 1))

        case "${class%:WT}" in
            PRIMARY)   echo "$id" >> "$kept" ;;
            PROTECTED) echo "$id" >> "$kept" ;;
            PROVEN)    echo "$id" >> "$proven" ;;
            ABANDONED) echo "$id" >> "$abandoned" ;;
            UNKNOWN)   echo "$id" >> "$unknown" ;;
        esac
    done

    local proven_count
    local abandoned_count
    local unknown_count
    local kept_count

    proven_count=$(wc -l < "$proven" | tr -d ' ')
    abandoned_count=$(wc -l < "$abandoned" | tr -d ' ')
    unknown_count=$(wc -l < "$unknown" | tr -d ' ')
    kept_count=$(wc -l < "$kept" | tr -d ' ')

    local clearing=$((proven_count + abandoned_count))

    clear
    title "Deletion Plan"

    if [[ "$proven_count" -gt 0 ]]; then
        echo "  ${GREEN}$proven_count${RESET} merged"
        echo "      already on $BASE_REF: by ancestry, by patch after a squash"
        echo "      merge, or by a merged pull request"
        echo
    fi

    if [[ "$abandoned_count" -gt 0 ]]; then
        echo "  ${GREEN}$abandoned_count${RESET} abandoned"
        echo "      the remote branch was deleted and no pull request is open"
        echo
    fi

    if [[ "$unknown_count" -gt 0 ]]; then
        echo "  ${YELLOW}$unknown_count${RESET} unclear"
        echo "      no signal either way; confirmed separately"
        echo
    fi

    if [[ "$kept_count" -gt 0 ]]; then
        echo "  ${CYAN}$kept_count${RESET} kept"
        echo "      protected, or checked out in the primary worktree"
        echo
    fi

    if [[ "$blocked" -gt 0 ]]; then
        info "$blocked of these $(plural_verb "$blocked") a worktree removed first, confirmed one by one."
        echo
    fi

    if [[ "$clearing" -eq 0 && "$unknown_count" -eq 0 ]]; then
        warning "Nothing in this selection can be deleted."
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    #
    # One question for everything the ladder found evidence for. Asking once per
    # group would only make the common case slower without saying anything the
    # plan above has not already said.
    #
    if [[ "$clearing" -gt 0 ]]; then
        echo "Deleting a branch drops the label, never the commits: the hash of"
        echo "each one is printed, and it stays in the reflog."
        echo

        if confirm "Delete these $clearing branches?"; then
            echo
            run_confirmed_deletions "$proven" "merged"
            run_confirmed_deletions "$abandoned" "abandoned"
        else
            info "Kept all $clearing."
        fi
    fi

    if [[ "$unknown_count" -gt 0 ]]; then
        run_forced_deletions "$unknown" "$report"
    fi

    echo
    gum input --placeholder "Press Enter to continue" >/dev/null
}

#
# Everything in these groups is already authorised by the plan's single
# confirmation, so the safe deletion is not attempted first: git branch -d
# refuses a squash-merged or abandoned tip by definition, and printing that
# refusal only to override it reads like a failure.
#
run_confirmed_deletions() {
    local list="$1"
    local reason="$2"

    local id
    local branch

    load_ids "$(cat "$list")"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        branch="$(branch_field "$id" 2)"

        remove_blocking_worktree "$branch" || continue
        force_delete_branch "$branch" "$reason"
    done
}

#
# The evidence table and the typed confirmation cover the whole forced group at
# once. A squash merge leaves every branch looking unmerged, so this is the
# normal path in a squash-merge repository, not an exception.
#
run_forced_deletions() {
    local list="$1"
    local report="$2"

    local count
    count=$(wc -l < "$list" | tr -d ' ')

    write_evidence_table "$(cat "$list")" "$report"

    echo
    gum pager < "$report"

    warning "Force deleting $count branch(es) skips every merge check."
    echo
    echo "UNMERGED counts commits that are not on $BASE_REF. A squash merge"
    echo "rewrites the commits, so a squash-merged branch shows a count here"
    echo "too; a non-zero number is not by itself proof of lost work."
    echo
    echo "The commit hash of every deleted branch is printed, and it stays in"
    echo "the reflog, so a branch can be restored with 'git branch <name> <hash>'."
    echo

    if ! confirm "Force delete these $count branches?"; then
        info "Kept all $count."
        return
    fi

    local typed
    typed="$(gum input --placeholder "Type DELETE to confirm")"

    if [[ "$typed" != "DELETE" ]]; then
        warning "Confirmation did not match; kept all $count."
        return
    fi

    local id
    local branch

    load_ids "$(cat "$list")"

    for id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
        branch="$(branch_field "$id" 2)"

        remove_blocking_worktree "$branch" || continue
        force_delete_branch "$branch"
    done
}

review_branch_individually() {
    local id="$1"

    local branch
    local worktree
    local pr
    local gone

    branch="$(branch_field "$id" 2)"
    pr="$(branch_field "$id" 9)"
    gone="$(branch_field "$id" 6)"

    refresh_worktree_list
    worktree="$(branch_worktree_path "$branch")"

    clear
    title "$branch"

    git log \
        "$branch" \
        -15 \
        --date=short \
        --format='%h %ad %s' |
        gum pager

    if [[ -n "$worktree" ]]; then
        warning "This branch is checked out in $worktree."
        echo

        if ! remove_blocking_worktree "$branch"; then
            gum input --placeholder "Press Enter to continue" >/dev/null
            return
        fi
    fi

    local action
    action="$(
        menu \
            "What should happen?" \
            "Try safe delete" \
            "Force delete local branch" \
            "Keep" \
            "Back"
    )"

    case "$action" in
        "Try safe delete")
            local output

            if output="$(git branch -d "$branch" 2>&1)"; then
                success "Deleted branch."
                mark_state_stale
            else
                report_git_refusal "$branch" "$output"
                gum input --placeholder "Press Enter to continue" >/dev/null
            fi
            ;;

        "Force delete local branch")
            warning "This may delete the only remaining copy of unmerged work."

            if [[ "$pr" == "merged" ]]; then
                info "GitHub reports that this branch's PR was merged."
            elif [[ "$gone" == "true" ]]; then
                warning "The remote branch is gone, but that does NOT prove it was merged."
            fi

            if confirm "Force delete '$branch'?"; then
                local typed

                typed="$(
                    gum input \
                        --placeholder "Type DELETE to confirm"
                )"

                if [[ "$typed" == "DELETE" ]]; then
                    force_delete_branch "$branch"
                fi
            fi
            ;;
    esac
}

#
# One list, one action.
#
# The old flow asked for a cleanup mode before showing anything, then asked which
# deletion strategy to use. Both questions came too early: the buckets overlap, so
# there is no right mode to pick, and a mixed selection has no single right
# strategy. The list already carries the flags, gum filters on them as you type,
# and the plan decides the strategy per branch.
#
branch_menu() {
    while true; do
        refresh_repository_state_if_stale

        clear
        title "Local Branch Cleanup"

        local selected
        local ids

        selected="$(select_branches)" || return
        [[ -z "$selected" ]] && return

        ids="$(printf '%s\n' "$selected" | selected_ids)"

        local next
        next="$(
            menu \
                "$(wc -l <<< "$ids" | tr -d ' ') branch(es) selected" \
                "Delete selected" \
                "Inspect selection" \
                "Review selected individually" \
                "Back to the list"
        )"

        case "$next" in
            "Delete selected")
                delete_selected_branches "$ids"
                ;;

            "Inspect selection")
                show_branch_details "$ids"
                ;;

            "Review selected individually")
                local branch_id

                load_ids "$ids"

                for branch_id in ${SELECTED_IDS[@]+"${SELECTED_IDS[@]}"}; do
                    review_branch_individually "$branch_id"
                done
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# One-shot cleanup
# -----------------------------------------------------------------------------

#
# The whole tool in one action: every local branch goes through the evidence
# ladder and the plan says what happens, with no list to work through first.
# Picking twenty branches out of a filter one Tab at a time is the step that
# stops a cleanup from happening at all.
#
# The manual paths stay for what this cannot answer: reviewing a single branch,
# or going after something the ladder files under "unclear".
#
#
# The whole tool in one action.
#
# It used to be branch-only while calling itself a repository cleanup, so a
# worktree whose pull request was merged months ago stayed behind unless it
# happened to block a branch deletion — and the dashboard counted 20 of those
# right above the menu entry that would not touch them.
#
# Worktrees go first, because removing one is what frees the branch underneath
# it, so the branch pass then finds nothing pinned.
#
clean_up_now() {
    refresh_repository_state_if_stale

    local worktree_ids
    local branch_ids

    worktree_ids="$(cut -f1 "$WORKTREE_DATA")"
    branch_ids="$(cut -f1 "$BRANCH_DATA")"

    if [[ -z "$worktree_ids" && -z "$branch_ids" ]]; then
        clear
        title "Clean Up"
        success "Nothing here besides ${PRIMARY_BRANCH:-the primary branch}."
        echo
        gum input --placeholder "Press Enter to continue" >/dev/null
        return
    fi

    if [[ -n "$worktree_ids" ]]; then
        plan_worktree_removals "$worktree_ids"
        refresh_repository_state_if_stale
        branch_ids="$(cut -f1 "$BRANCH_DATA")"
    fi

    if [[ -n "$branch_ids" ]]; then
        delete_selected_branches "$branch_ids"
    fi
}

# -----------------------------------------------------------------------------
# Final report
# -----------------------------------------------------------------------------

show_final_report() {
    refresh_repository_state_if_stale

    clear
    title "Cleanup Summary"

    echo "${BOLD}Remaining worktrees${RESET}"
    echo
    git worktree list

    echo
    echo "${BOLD}Remaining local branches with gone upstream${RESET}"
    echo

    local remaining

    remaining="$(
        git for-each-ref \
            --sort=committerdate \
            --format='%(committerdate:short)  %(refname:short)  %(upstream:track)' \
            refs/heads |
            grep '\[gone\]' || true
    )"

    if [[ -n "$remaining" ]]; then
        echo "$remaining"
    else
        success "None."
    fi

    echo
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

#
# Wrapped in a function, and called only when this file is run rather than
# sourced, so the tests can load the classification and selection logic and
# exercise it against a scratch repository. Sourcing a script whose body runs on
# load means testing it through the interface, which for a gum front end means
# not testing it at all.
#
main() {
    ensure_dependencies
    ensure_github_auth

    require_git_repository
    check_for_update "$@"

    initialize_repository

    MENU_HEIGHT="$DEFAULT_HEIGHT"
    LIST_HEIGHT="$DEFAULT_HEIGHT"

    clear
    title "Git Cleanup Assistant"

    echo "Repository:     $REPO_ROOT"
    echo "Primary tree:   $PRIMARY_WORKTREE"
    echo "Primary branch: $PRIMARY_BRANCH"
    echo

    if confirm "Fetch remote references and prune deleted tracking branches?"; then
        git fetch --prune
    fi

    #
    # Only asked for what changes an answer.
    #
    # The stale threshold used to be the first of two prompts, before the user
    # had seen anything at all, and it decides nothing: no branch and no worktree
    # is classified by age. It is a number on the dashboard, so it takes a
    # default and an environment variable rather than a prompt.
    #
    STALE_DAYS="${GIT_CLEANUP_ASSISTANT_STALE_DAYS:-$DEFAULT_STALE_DAYS}"

    if ! [[ "$STALE_DAYS" =~ ^[0-9]+$ ]]; then
        warning "Invalid stale threshold; using $DEFAULT_STALE_DAYS days."
        STALE_DAYS="$DEFAULT_STALE_DAYS"
    fi

    BASE_REF="$(
        input_value \
            "Base ref used for Git merge checks" \
            "$DEFAULT_BASE_REF"
    )"

    if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
        warning "'$BASE_REF' does not exist; using $DEFAULT_BASE_REF."
        BASE_REF="$DEFAULT_BASE_REF"
    fi

    if [[ "$GH_AVAILABLE" == true ]]; then
        refresh_pr_cache
    fi

    refresh_repository_state

    while true; do
        show_dashboard

        action="$(
            menu \
                "What would you like to do?" \
                "Clean up everything" \
                "Worktrees" \
                "Local branches" \
                "Refresh Git / GitHub data" \
                "Show remaining summary" \
                "Finish"
        )"

        case "$action" in
            "Clean up everything")
                clean_up_now
                ;;

            "Worktrees")
                worktree_menu
                ;;

            "Local branches")
                branch_menu
                ;;

            "Refresh Git / GitHub data")
                if confirm "Fetch and prune remotes?"; then
                    git fetch --prune
                fi

                if [[ "$GH_AVAILABLE" == true ]]; then
                    refresh_pr_cache
                fi

                # Asked for explicitly, so it rescans whether or not this
                # session changed anything.
                refresh_repository_state
                ;;

            "Show remaining summary")
                show_final_report
                gum input --placeholder "Press Enter to continue" >/dev/null
                ;;

            "Finish"|*)
                break
                ;;
        esac
    done

    show_final_report

    success "Cleanup assistant finished."
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
